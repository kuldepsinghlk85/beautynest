<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:page_title) ? "#{yield(:page_title)} — #{site_name} Admin" : "#{site_name} Admin Platform" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <script>
    (function(){
      var theme = localStorage.getItem('bc-theme') || 'dark';
      document.documentElement.setAttribute('data-bs-theme', theme);
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <!-- Tabler Core CSS & Tabler Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <!-- Tabler Core JS (Bundles Bootstrap 5) & Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/js/tabler.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <!-- Leaflet Map CSS & JS (OpenStreetMap) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
</head>
<body class="layout-fluid" data-controller="theme confirm-modal">
  <div class="page">
    <%= render "layouts/sidebar" %>
    <%= render "layouts/header" %>

    <div class="page-wrapper">
      <div class="page-body">
        <div class="container-xl">
          <!-- Flash Messages -->
          <% if flash[:notice].present? %>
            <div class="alert alert-success alert-dismissible mb-4" role="alert">
              <div class="d-flex">
                <div><i class="ti ti-check fs-2 me-2"></i></div>
                <div><%= flash[:notice] %></div>
              </div>
              <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
            </div>
          <% end %>

          <% if flash[:alert].present? %>
            <div class="alert alert-danger alert-dismissible mb-4" role="alert">
              <div class="d-flex">
                <div><i class="ti ti-alert-triangle fs-2 me-2"></i></div>
                <div><%= flash[:alert] %></div>
              </div>
              <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </div>

      <footer class="footer footer-transparent d-print-none mt-auto">
        <div class="container-xl">
          <div class="row text-center align-items-center flex-row-reverse">
            <div class="col-lg-auto ms-lg-auto">
              <ul class="list-inline list-inline-dots mb-0">
                <% if !current_user&.worker? %>
                  <li class="list-inline-item"><a href="<%= admin_settings_path %>" class="link-secondary">Settings</a></li>
                <% end %>
                <li class="list-inline-item"><a href="/api/v1/auth/login" target="_blank" class="link-secondary">API Docs</a></li>
                <li class="list-inline-item">
                  <a href="/user_manual_and_tutorial.html" target="_blank" class="link-secondary me-1">
                    <i class="ti ti-book me-1"></i> User Guide
                  </a>
                </li>
                <li class="list-inline-item">
                  <a href="/beautynest-user-manual-and-tutorial.pdf" target="_blank" download class="badge bg-purple-lt text-purple text-decoration-none py-1 px-2 fw-bold d-inline-flex align-items-center gap-1 shadow-sm" title="Download Official Tutorial PDF">
                    <i class="ti ti-file-type-pdf fs-2"></i> Tutorial (PDF)
                  </a>
                </li>
              </ul>
            </div>
            <div class="col-12 col-lg-auto mt-3 mt-lg-0">
              <ul class="list-inline list-inline-dots mb-0">
                <li class="list-inline-item">
                  Copyright &copy; <%= Time.current.year %>
                  <a href="<%= admin_dashboard_path %>" class="link-secondary fw-semibold"><%= site_name %></a>. All rights reserved.
                </li>
              </ul>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </div>
  <%= render "layouts/confirm_modal" %>
</body>
</html>