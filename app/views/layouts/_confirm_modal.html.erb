<%# frozen_string_literal: true %>
<!-- Global Confirmation Modal for Destructive Actions & Turbo Confirmations -->
<div class="modal modal-blur fade" id="global-confirm-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title" aria-describedby="confirm-modal-message" style="display: none; z-index: 1060;">
  <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
      <div class="modal-status bg-danger" id="confirm-modal-status" style="height: 4px;"></div>
      <button type="button" class="btn-close position-absolute top-0 end-0 m-3" id="confirm-modal-close" aria-label="Close" style="z-index: 10;"></button>
      <div class="modal-body text-center py-4 px-4">
        <div class="avatar avatar-lg rounded-circle bg-danger-subtle text-danger mx-auto mb-3" id="confirm-modal-avatar" style="width: 56px; height: 56px;">
          <i class="ti ti-trash fs-1" id="confirm-modal-icon"></i>
        </div>
        <h3 class="fw-bold mb-2 text-1" id="confirm-modal-title">Confirm Deletion</h3>
        <p class="text-secondary mb-1" id="confirm-modal-message">Are you sure you want to delete this item?</p>
        <p class="text-muted small mb-0" id="confirm-modal-detail" style="display: none;"></p>
      </div>
      <div class="modal-footer border-0 pt-0 pb-4 px-4">
        <div class="w-100">
          <div class="row g-2">
            <div class="col-6">
              <button type="button" class="btn btn-outline-secondary w-100 fw-semibold" id="confirm-modal-cancel" style="border-radius: 8px;">
                Cancel
              </button>
            </div>
            <div class="col-6">
              <button type="button" class="btn btn-danger w-100 fw-semibold shadow-sm" id="confirm-modal-confirm" style="border-radius: 8px;">
                <i class="ti ti-trash me-1" id="confirm-modal-btn-icon"></i> <span id="confirm-modal-confirm-text">Delete</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="modal-backdrop fade show" id="global-confirm-backdrop" style="display: none; z-index: 1050; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"></div>
