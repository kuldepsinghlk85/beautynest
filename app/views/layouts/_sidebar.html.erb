<%
  if current_user&.worker?
    nav_items = [
      { section: nil, items: [
        { label: "My Dashboard", path: admin_dashboard_path, icon: "layout-dashboard", ctrl: "dashboard" }
      ]},
      { section: "My Operations", items: [
        { label: "My Customers",    path: admin_customers_path,      icon: "users",            ctrl: "customers"      },
        { label: "My Bookings",     path: admin_bookings_path,       icon: "calendar-event",   ctrl: "bookings"       },
        { label: "My Services",     path: admin_services_path,       icon: "cut",              ctrl: "services"       },
        { label: "My Reviews",      path: admin_reviews_path,        icon: "star",             ctrl: "reviews"        },
        { label: "My Earnings",     path: admin_payments_path,       icon: "credit-card",      ctrl: "payments"       },
        { label: "Notifications",   path: admin_notifications_path,  icon: "bell",             ctrl: "notifications"  }
      ]},
      { section: "Account", items: [
        { label: "My Profile",   path: (current_user ? admin_worker_path(current_user.id) : "#"), icon: "user", ctrl: "workers" }
      ]}
    ]
  else
    nav_items = [
      { section: nil, items: [
        { label: "Dashboard",     path: admin_dashboard_path,      icon: "layout-dashboard", ctrl: "dashboard" }
      ]},
      { section: "Users", items: [
        { label: "Customers",      path: admin_customers_path,          icon: "users",            ctrl: "customers"  },
        { label: "Workers",        path: admin_workers_path,            icon: "user-check",       ctrl: "workers"    },
        { label: "Worker Invites", path: admin_worker_invitations_path, icon: "mail-forward",     ctrl: "worker_invitations" }
      ]},
      { section: "Catalog", items: [
        { label: "Categories",    path: admin_categories_path,     icon: "category",         ctrl: "categories" },
        { label: "Subcategories", path: admin_subcategories_path,  icon: "subtask",          ctrl: "subcategories" },
        { label: "Services",      path: admin_services_path,       icon: "cut",              ctrl: "services"   }
      ]},
      { section: "Operations", items: [
        { label: "Cities",        path: admin_cities_path,         icon: "building",         ctrl: "cities"     },
        { label: "Bookings",      path: admin_bookings_path,       icon: "calendar-event",   ctrl: "bookings"   },
        { label: "Payments",      path: admin_payments_path,       icon: "credit-card",      ctrl: "payments"   },
        { label: "Coupons",       path: admin_coupons_path,        icon: "discount-2",       ctrl: "coupons"    }
      ]},
      { section: "Quality", items: [
        { label: "Reviews",       path: admin_reviews_path,        icon: "star",             ctrl: "reviews"    },
        { label: "Notifications", path: admin_notifications_path,  icon: "bell",             ctrl: "notifications"}
      ]},
      { section: "System", items: [
        { label: "Audit Logs",    path: admin_audit_logs_path,     icon: "history",          ctrl: "audit_logs" },
        { label: "Settings",      path: admin_settings_path,       icon: "settings",         ctrl: "settings"   }
      ]},
      { section: "Live Storefront", items: [
        { label: "View Website", path: root_path, icon: "world", ctrl: "storefront", target: "_blank" },
        { label: "User Manual (PDF)", path: "/beautynest-user-manual-and-tutorial.pdf", icon: "file-type-pdf", ctrl: "tutorial", target: "_blank" }
      ]}
    ]
  end
  current_ctrl = controller.controller_name
%>

<aside class="navbar navbar-vertical navbar-expand-lg" id="navbar-vertical">
  <div class="container-fluid">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <h1 class="navbar-brand navbar-brand-autodark px-2">
      <a href="<%= admin_dashboard_path %>" class="d-flex align-items-center text-decoration-none">
        <span class="avatar avatar-sm me-2 rounded-2 shadow-sm flex-shrink-0"
              style="background: linear-gradient(135deg, #db2777, #be185d); color: #fff;">
          <i class="ti ti-sparkles fs-3"></i>
        </span>
        <div class="text-start">
          <span class="fs-2 fw-bold d-block lh-1 site-name" style="letter-spacing: -0.02em;">
            <span style="color: #db2777;">Beauty</span><span style="color: #ffffff;">Connect</span>
          </span>
          <span class="fw-medium mt-1" style="font-size: 0.62rem; color: rgba(255,255,255,0.40); letter-spacing: 0.08em; text-transform: uppercase;">
            <%= current_user&.worker? ? "Worker Portal" : "Admin Panel" %>
          </span>
        </div>
      </a>
    </h1>
    
    <div class="navbar-nav flex-row d-lg-none">
      <div class="nav-item">
        <a href="<%= logout_path %>" class="nav-link px-0 text-danger" title="Sign Out" data-turbo="false">
          <i class="ti ti-logout fs-2"></i>
        </a>
      </div>
    </div>

    <div class="collapse navbar-collapse" id="sidebar-menu">
      <ul class="navbar-nav pt-lg-3">
        <% nav_items.each do |group| %>
          <% if group[:section] %>
            <li class="nav-item text-uppercase fw-bold px-3 mt-3 mb-1"
              style="letter-spacing: 0.07em; font-size: 0.68rem; color: var(--sidebar-section-text);">
              <%= group[:section] %>
            </li>
          <% end %>
          <% group[:items].each do |item| %>
            <li class="nav-item <%= 'active' if current_ctrl == item[:ctrl] %>">
              <a class="nav-link <%= 'active fw-semibold' if current_ctrl == item[:ctrl] %>" href="<%= item[:path] %>" <%= "target=\"#{item[:target]}\"".html_safe if item[:target] %>>
                <span class="nav-link-icon d-md-none d-lg-inline-block">
                  <i class="ti ti-<%= item[:icon] %> fs-2"></i>
                </span>
                <span class="nav-link-title">
                  <%= item[:label] %>
                </span>
              </a>
            </li>
          <% end %>
        <% end %>
      </ul>

      <!-- Help & User Manual in Sidebar -->
      <div class="px-3 pt-3 mt-auto d-none d-lg-block">
        <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, rgba(217, 70, 239, 0.08) 0%, rgba(79, 70, 229, 0.08) 100%); border-radius: 12px; border: 1px solid rgba(217, 70, 239, 0.2) !important;">
          <div class="card-body p-3">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="avatar avatar-xs rounded-circle bg-purple text-white" style="width: 26px; height: 26px;">
                <i class="ti ti-book fs-3"></i>
              </span>
              <span class="fw-bold small text-1" style="font-size: 0.8rem;">User Manual &amp; Tutorial</span>
            </div>
            <p class="text-secondary small mb-2" style="font-size: 0.73rem; line-height: 1.35;">
              कस्टमर बुकिंग, ब्यूटीशियन स्लॉट &amp; एडमिन गाइड
            </p>
            <div class="d-flex gap-1">
              <a href="/user_manual_and_tutorial.html" target="_blank" class="btn btn-outline-primary btn-sm w-50 py-1" style="font-size: 0.72rem; border-radius: 6px;">
                <i class="ti ti-eye me-1"></i> View
              </a>
              <a href="/beautynest-user-manual-and-tutorial.pdf" target="_blank" download class="btn btn-primary btn-sm w-50 py-1" style="font-size: 0.72rem; border-radius: 6px; background: linear-gradient(135deg, #d946ef 0%, #4f46e5 100%); border: none;">
                <i class="ti ti-download me-1"></i> PDF
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- User footer in sidebar -->
      <div class="pt-3 border-top d-none d-lg-block">
        <div class="d-flex align-items-center px-3 py-2">
          <% sidebar_user = current_user || current_admin %>
          <%= user_avatar_tag(sidebar_user, size: :sm, class_name: "me-3") %>
          <div class="overflow-hidden me-auto">
            <div class="font-weight-medium text-truncate fs-4"><%= sidebar_user&.name || (sidebar_user&.worker? ? "Worker User" : "Admin User") %></div>
            <div class="text-secondary text-truncate fs-5"><%= sidebar_user&.worker? ? "Worker / Beautician" : (sidebar_user&.role&.titleize || "Super Admin") %></div>
          </div>
          <%= link_to logout_path, class: "btn btn-icon btn-ghost-danger btn-sm", title: "Sign Out", data: { turbo: false } do %>
            <i class="ti ti-logout fs-3"></i>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</aside>
