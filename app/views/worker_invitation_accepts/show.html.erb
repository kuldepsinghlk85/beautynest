<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accept Professional Invitation — <%= Setting.site_name %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.14.0/dist/tabler-icons.min.css">
  
  <style>
    :root {
      --primary-pink: #db2777;
      --primary-pink-hover: #be185d;
      --primary-pink-light: #fdf2f8;
      --primary-pink-border: rgba(219, 39, 119, 0.25);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --bg-page: #f8fafc;
      --card-bg: #ffffff;
      --border-color: #e2e8f0;
      --input-border: #cbd5e1;
    }

    * {
      box-sizing: border-box;
    }

    html {
      height: 100%;
      overflow-y: auto !important;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-page);
      background-image: 
        radial-gradient(at 0% 0%, rgba(219, 39, 119, 0.08) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(147, 51, 234, 0.06) 0px, transparent 50%),
        radial-gradient(at 50% 50%, rgba(244, 114, 182, 0.05) 0px, transparent 60%);
      background-attachment: fixed;
      min-height: 100%;
      height: auto !important;
      overflow-y: auto !important;
      overflow-x: hidden;
      padding: 0;
      margin: 0;
      color: var(--text-main);
      -webkit-font-smoothing: antialiased;
    }

    .onboarding-wrapper {
      min-height: 100vh;
      width: 100%;
      padding: 40px 16px 80px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    .onboarding-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 24px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.03);
      width: 100%;
      max-width: 720px;
      overflow: hidden;
      margin: 0 auto;
    }

    .onboarding-header {
      background: linear-gradient(135deg, #1e1b4b 0%, #311042 50%, #4a044e 100%);
      padding: 36px 32px 32px;
      color: #ffffff;
      position: relative;
      overflow: hidden;
    }

    .onboarding-header::after {
      content: "";
      position: absolute;
      top: -30px;
      right: -30px;
      width: 160px;
      height: 160px;
      background: radial-gradient(circle, rgba(219, 39, 119, 0.4) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 6px 14px;
      border-radius: 50px;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      color: #fbcfe8;
      margin-bottom: 12px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.05rem;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1.5px solid #f1f5f9;
    }

    .section-title i {
      font-size: 1.25rem;
      color: var(--primary-pink);
    }

    .form-label {
      font-weight: 600;
      font-size: 0.86rem;
      color: #334155;
      margin-bottom: 6px;
    }

    .form-label.required::after {
      content: " *";
      color: #e11d48;
      font-weight: bold;
    }

    .form-control, .form-select {
      background-color: #ffffff;
      border: 1.5px solid var(--input-border);
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 0.92rem;
      color: #0f172a;
      transition: all 0.18s ease;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--primary-pink);
      box-shadow: 0 0 0 3px rgba(219, 39, 119, 0.15);
      outline: none;
    }

    .input-icon {
      position: relative;
    }

    .input-icon .form-control {
      padding-left: 40px;
    }

    .input-icon-addon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      display: flex;
      align-items: center;
      pointer-events: none;
      font-size: 1.15rem;
    }

    .input-icon .form-control:focus + .input-icon-addon,
    .input-icon:focus-within .input-icon-addon {
      color: var(--primary-pink);
    }

    /* Interactive Skill Chips */
    .skills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .skill-chip {
      position: relative;
      cursor: pointer;
      user-select: none;
    }

    .skill-chip input[type="checkbox"] {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }

    .skill-chip-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 600;
      color: #475569;
      transition: all 0.16s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .skill-chip-label .chip-icon {
      font-size: 1rem;
      opacity: 0;
      transform: scale(0.5);
      transition: all 0.16s ease;
      width: 0;
      margin: 0;
    }

    .skill-chip input[type="checkbox"]:checked + .skill-chip-label {
      background: #fdf2f8;
      border-color: var(--primary-pink);
      color: var(--primary-pink);
      box-shadow: 0 2px 8px rgba(219, 39, 119, 0.15);
    }

    .skill-chip input[type="checkbox"]:checked + .skill-chip-label .chip-icon {
      opacity: 1;
      transform: scale(1);
      width: auto;
      margin-right: 2px;
    }

    .skill-chip:hover .skill-chip-label {
      border-color: #cbd5e1;
      background: #f1f5f9;
    }

    .skill-chip input[type="checkbox"]:checked:hover + .skill-chip-label {
      border-color: var(--primary-pink-hover);
      background: #fce7f3;
    }

    /* Submit CTA Button */
    .btn-submit-onboarding {
      background: linear-gradient(135deg, #db2777 0%, #be185d 100%);
      color: #ffffff;
      border: none;
      border-radius: 14px;
      padding: 14px 28px;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 8px 20px -4px rgba(219, 39, 119, 0.35);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
    }

    .btn-submit-onboarding:hover {
      background: linear-gradient(135deg, #e11d48 0%, #9f1239 100%);
      transform: translateY(-2px);
      box-shadow: 0 12px 26px -4px rgba(219, 39, 119, 0.45);
      color: #ffffff;
    }

    .btn-submit-onboarding:active {
      transform: translateY(0);
    }

    .invitation-badge-card {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 14px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      color: #166534;
      font-size: 0.88rem;
    }

    .form-hint {
      font-size: 0.76rem;
      color: #64748b;
      margin-top: 4px;
    }
  </style>
</head>
<body>
  <div class="onboarding-wrapper">
    <div class="onboarding-card">
      <!-- Header Banner -->
      <div class="onboarding-header">
        <div class="brand-badge">
          <i class="ti ti-sparkles text-pink"></i> <%= Setting.site_name %> Professional
        </div>
        <h1 class="h2 fw-bold text-white mb-2">Beautician & Staff Onboarding</h1>
        <p class="text-white-50 fs-5 mb-0">Complete your profile details to join our verified service professional network.</p>
      </div>

      <!-- Form Content Body -->
      <div class="p-4 p-md-5">
        
        <!-- Invitation Context Alert -->
        <div class="invitation-badge-card mb-4">
          <div class="avatar avatar-sm rounded-circle bg-success text-white flex-shrink-0" style="width: 34px; height: 34px;">
            <i class="ti ti-mail-check fs-2"></i>
          </div>
          <div>
            <div>Official invitation sent to <strong class="text-success-emphasis"><%= @invitation.email %></strong></div>
            <div class="small text-secondary" style="font-size: 0.78rem;">Invited by <strong><%= @invitation.invited_by&.name || "Platform Administrator" %></strong></div>
          </div>
        </div>

        <% if @errors.present? %>
          <div class="alert alert-danger mb-4 shadow-sm" role="alert" style="border-radius: 14px; background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b;">
            <div class="d-flex align-items-center mb-2">
              <i class="ti ti-alert-circle fs-2 me-2"></i>
              <h4 class="alert-title mb-0 fw-bold">Please correct the following:</h4>
            </div>
            <ul class="mb-0 ps-3 small">
              <% @errors.each do |err| %>
                <li><%= err %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with url: worker_invitation_accept_path(token: @invitation.token), method: :post, local: true do %>
          
          <!-- ── Section 1: Account Credentials ── -->
          <div class="section-title">
            <i class="ti ti-user-shield"></i>
            <span>1. Account Information</span>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label required">Full Name</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-user"></i></span>
                <input type="text" name="user[name]" class="form-control" required
                       value="<%= @user&.name.presence || @invitation.name %>" placeholder="e.g. Priya Sharma">
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label required">Mobile Number</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-phone"></i></span>
                <input type="tel" name="user[phone]" class="form-control" required
                       value="<%= @user&.phone.presence || @invitation.phone %>" placeholder="+91 98765 43210">
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label required">Create Login Password</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-lock"></i></span>
                <input type="password" name="user[password]" class="form-control" required minlength="6"
                       placeholder="At least 6 characters">
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label required">Confirm Login Password</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-lock-check"></i></span>
                <input type="password" name="user[password_confirmation]" class="form-control" required minlength="6"
                       placeholder="Re-enter password">
              </div>
            </div>
          </div>

          <!-- ── Section 2: Professional & KYC Details ── -->
          <div class="section-title mt-4">
            <i class="ti ti-id-badge-2"></i>
            <span>2. Professional & KYC Verification</span>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label required">12-Digit Aadhaar Number</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-shield-check"></i></span>
                <input type="text" name="profile[aadhaar_number]" class="form-control" required pattern="\d{12}" maxlength="12"
                       value="<%= @profile&.aadhaar_number %>" placeholder="123456789012">
              </div>
              <div class="form-hint">Government ID required for customer safety verification.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label required">Experience (in Years)</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-briefcase"></i></span>
                <input type="number" name="profile[experience_years]" class="form-control" min="0" max="50" required
                       value="<%= @profile&.experience_years || 2 %>" placeholder="e.g. 3">
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Operating City</label>
              <select name="profile[city_id]" class="form-select">
                <option value="">Select Service City</option>
                <% @cities&.each do |c| %>
                  <option value="<%= c.id %>" <%= "selected" if (@invitation.city_id == c.id || @profile&.city_id == c.id) %>><%= c.name %></option>
                <% end %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label">UPI ID for Payouts (Optional)</label>
              <div class="input-icon">
                <span class="input-icon-addon"><i class="ti ti-currency-rupee"></i></span>
                <input type="text" name="profile[upi_id]" class="form-control"
                       value="<%= @profile&.upi_id %>" placeholder="name@upi / username@okhdfcbank">
              </div>
            </div>

            <div class="col-md-12">
              <label class="form-label">Professional Bio & Specialties</label>
              <textarea name="profile[bio]" class="form-control" rows="2"
                        placeholder="Briefly describe your salon expertise, certifications, and service experience..."><%= @profile&.bio.presence || @invitation.speciality %></textarea>
            </div>
          </div>

          <!-- ── Section 3: Skills & Services Chips ── -->
          <div class="section-title mt-4">
            <i class="ti ti-cut"></i>
            <span>3. Skills & Service Expertise</span>
          </div>

          <div class="mb-4">
            <label class="form-label mb-2 d-block text-secondary small">Select all beauty and wellness services you are trained to perform:</label>
            <div class="skills-grid">
              <% (@available_skills || []).each_with_index do |skill, idx| %>
                <label class="skill-chip">
                  <input type="checkbox" name="profile[skills][]" value="<%= skill %>"
                         <%= "checked" if @invitation.speciality&.include?(skill) || idx < 3 %>>
                  <span class="skill-chip-label">
                    <i class="ti ti-check chip-icon"></i>
                    <span><%= skill %></span>
                  </span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="mt-4 pt-2">
            <button type="submit" class="btn-submit-onboarding">
              <i class="ti ti-circle-check fs-2"></i>
              <span>Complete Onboarding & Activate Profile</span>
            </button>
          </div>

        <% end %>

        <div class="text-center mt-4 pt-3 border-top" style="border-color: #f1f5f9 !important;">
          <p class="text-secondary small mb-0">
            Already registered as a professional? 
            <a href="<%= login_path %>" class="fw-bold text-pink text-decoration-none ms-1" style="color: #db2777;">Sign In to Worker Portal</a>
          </p>
        </div>

      </div>
    </div>
  </div>
</body>
</html>
