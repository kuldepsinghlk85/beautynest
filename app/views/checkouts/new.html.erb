<script>
  function toggleAddressActive(radio) {
    document.querySelectorAll('.bn-address-card').forEach(function(card) {
      card.classList.remove('active');
    });
    if (radio.checked) {
      radio.closest('.bn-address-card').classList.add('active');
      var form = document.getElementById('bn-new-address-fields');
      if (form) form.style.display = 'none';
    }
  }

  function togglePayActive(radio) {
    document.querySelectorAll('.bn-pay-card').forEach(function(card) {
      card.classList.remove('active');
    });
    if (radio.checked) {
      radio.closest('.bn-pay-card').classList.add('active');
    }
  }

  function toggleNewAddressForm() {
    var form = document.getElementById('bn-new-address-fields');
    if (!form) return;
    if (form.style.display === 'none' || form.style.display === '') {
      form.style.display = 'flex';
      // Deselect saved addresses
      document.querySelectorAll('.bn-addr-radio').forEach(function(r) { r.checked = false; });
      document.querySelectorAll('.bn-address-card').forEach(function(c) { c.classList.remove('active'); });
    } else {
      form.style.display = 'none';
      var firstRadio = document.querySelector('.bn-addr-radio');
      if (firstRadio) {
        firstRadio.checked = true;
        firstRadio.closest('.bn-address-card').classList.add('active');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('bn-checkout-form');
    var btn = document.getElementById('bn-confirm-booking-btn');
    if (!form || !btn) return;

    form.addEventListener('submit', function(e) {
      var newAddrBox = document.getElementById('bn-new-address-fields');
      var isNewAddrVisible = newAddrBox && newAddrBox.style.display !== 'none';
      var savedAddrRadios = document.querySelectorAll('.bn-addr-radio');
      var hasSavedAddresses = savedAddrRadios.length > 0;
      
      var isUsingSavedAddress = hasSavedAddresses && !isNewAddrVisible;
      var missing = [];

      // Clear previous error styles
      document.querySelectorAll('.bn-input-error').forEach(function(el) {
        el.classList.remove('bn-input-error');
      });

      if (isUsingSavedAddress) {
        var anyChecked = Array.from(savedAddrRadios).some(function(r) { return r.checked; });
        if (!anyChecked) {
          missing.push('Delivery Address');
        }
      } else {
        var nameInput = document.getElementById('bn-cust-name');
        var phoneInput = document.getElementById('bn-cust-phone');
        var line1Input = document.getElementById('bn-addr-line1');
        var pincodeInput = document.getElementById('bn-addr-pincode');

        if (nameInput && !nameInput.value.trim()) {
          missing.push('Full Name');
          nameInput.classList.add('bn-input-error');
        }
        if (phoneInput && !phoneInput.value.trim()) {
          missing.push('Phone Number');
          phoneInput.classList.add('bn-input-error');
        } else if (phoneInput && phoneInput.value.trim().length < 8) {
          missing.push('Valid 10-digit Phone');
          phoneInput.classList.add('bn-input-error');
        }

        if (line1Input && !line1Input.value.trim()) {
          missing.push('House / Street Address');
          line1Input.classList.add('bn-input-error');
        }
        if (pincodeInput && !pincodeInput.value.trim()) {
          missing.push('Pincode');
          pincodeInput.classList.add('bn-input-error');
        }
      }

      if (missing.length > 0) {
        e.preventDefault();
        e.stopPropagation();

        var msg = 'Please provide required details: ' + missing.join(', ');
        if (window.showNotification) {
          window.showNotification(msg, 'error', 5000);
        } else {
          alert(msg);
        }

        var firstErr = document.querySelector('.bn-input-error');
        if (firstErr) {
          firstErr.focus();
          firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return false;
      }

      // Valid! Show interactive loading spinner on button and submit
      btn.disabled = true;
      btn.innerHTML = [
        '<span class="bn-spinner-svg"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg></span>',
        '<span>Securing Your Appointment...</span>'
      ].join('');

      // Allow form submission to proceed
    });
  });
</script>
