<!-- Hero Slider Interactive Script -->
<script>
  (function() {
    var currentSlide = 0;
    var slides = document.querySelectorAll('.bn-slide-item');
    var dots = document.querySelectorAll('.bn-dot');
    var totalSlides = slides.length;
    var sliderInterval = null;
    var sliderEl = document.getElementById('bn-hero-slider');

    if (!slides.length) return;

    function goToSlide(index) {
      if (index >= totalSlides) index = 0;
      if (index < 0) index = totalSlides - 1;
      
      slides.forEach(function(s, idx) {
        s.classList.toggle('active', idx === index);
      });
      dots.forEach(function(d, idx) {
        d.classList.toggle('active', idx === index);
      });
      currentSlide = index;
    }

    function nextSlide() {
      goToSlide(currentSlide + 1);
    }

    function prevSlide() {
      goToSlide(currentSlide - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      sliderInterval = setInterval(nextSlide, 4200);
    }

    function stopAutoPlay() {
      if (sliderInterval) clearInterval(sliderInterval);
    }

    // Prev / Next button listeners
    var prevBtn = document.getElementById('slider-prev-btn');
    var nextBtn = document.getElementById('slider-next-btn');

    if (prevBtn) {
      prevBtn.addEventListener('click', function(e) {
        e.preventDefault();
        prevSlide();
        startAutoPlay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function(e) {
        e.preventDefault();
        nextSlide();
        startAutoPlay();
      });
    }

    // Dot listeners
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var targetIndex = parseInt(this.getAttribute('data-slide'), 10);
        goToSlide(targetIndex);
        startAutoPlay();
      });
    });

    // Pause on hover
    if (sliderEl) {
      sliderEl.addEventListener('mouseenter', stopAutoPlay);
      sliderEl.addEventListener('mouseleave', startAutoPlay);

      // Touch swipe support
      var startX = 0;
      sliderEl.addEventListener('touchstart', function(e) {
        startX = e.touches[0].clientX;
        stopAutoPlay();
      }, { passive: true });

      sliderEl.addEventListener('touchend', function(e) {
        var diffX = e.changedTouches[0].clientX - startX;
        if (Math.abs(diffX) > 40) {
          if (diffX < 0) nextSlide();
          else prevSlide();
        }
        startAutoPlay();
      }, { passive: true });
    }

    startAutoPlay();
  })();
</script>
