<!-- ====================================================
     Dynamic Customer API & Screen Controller
     ==================================================== -->
<script>
  // State
  let currentCategoryId      = null;
  let currentCategorySlug    = null;
  let currentCategoryName    = null;
  let currentSubcategoryId   = 'all';
  let currentSubcategoryName = 'All Services';
  let currentCityId          = 'all';
  let currentSort            = 'featured';
  let searchQuery            = '';
  let searchDebounceTimer    = null;
  let lastApiPayload         = null;

  // ── Hero Slider ──
  (function() {
    let current = 0;
    const slides = document.querySelectorAll('.bc-slide');
    const dots   = document.querySelectorAll('.bc-dot');
    const total  = slides.length;

    function goTo(idx) {
      if (!slides.length) return;
      slides[current].classList.remove('bc-slide-active');
      dots[current].classList.remove('bc-dot-active');
      current = (idx + total) % total;
      slides[current].classList.add('bc-slide-active');
      dots[current].classList.add('bc-dot-active');
    }

    const prevBtn = document.getElementById('bc-slide-prev');
    const nextBtn = document.getElementById('bc-slide-next');
    if (prevBtn) prevBtn.addEventListener('click', () => goTo(current - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => goTo(current + 1));
    dots.forEach(d => d.addEventListener('click', () => goTo(+d.dataset.idx)));

    const slider = document.getElementById('bc-services-slider');
    let timer = setInterval(() => goTo(current + 1), 4500);
    if (slider) {
      slider.addEventListener('mouseenter', () => clearInterval(timer));
      slider.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 4500); });
    }
  })();

  // ── Toast Messenger ──
  function showToast(message, isSuccess = true) {
    const toast = document.getElementById('bc-toast');
    const msgEl = document.getElementById('bc-toast-msg');
    if (!toast || !msgEl) return;
    msgEl.textContent = message;
    const icon = toast.querySelector('i');
    if (icon) {
      icon.className = isSuccess ? 'ti ti-circle-check' : 'ti ti-alert-circle';
      icon.style.color = isSuccess ? '#22c55e' : '#f43f5e';
    }
    toast.classList.add('show');
    setTimeout(() => { toast.classList.remove('show'); }, 3500);
  }

  // ── Live API Console Display Updater ──
  function updateApiDisplay(method, endpoint, status, meta, data) {
    const methodEl   = document.getElementById('api-disp-method');
    const endpointEl = document.getElementById('api-disp-endpoint');
    const statusEl   = document.getElementById('api-disp-status');
    const metaEl     = document.getElementById('api-disp-meta');
    const drawerUrl  = document.getElementById('api-drawer-url');
    const drawerJson = document.getElementById('api-drawer-json');

    if (methodEl) {
      methodEl.textContent = method;
      methodEl.className = 'bc-api-badge-method' + (method === 'POST' ? ' post' : '');
    }
    if (endpointEl) endpointEl.textContent = endpoint;
    if (statusEl)   statusEl.textContent   = status;
    if (metaEl)     metaEl.textContent     = meta;
    if (drawerUrl)  drawerUrl.textContent  = window.location.origin + endpoint;
    if (drawerJson) {
      lastApiPayload = data;
      try {
        drawerJson.textContent = JSON.stringify(data, null, 2);
      } catch(e) {
        drawerJson.textContent = String(data);
      }
    }
  }

  window.toggleApiInspector = function() {
    const drawer = document.getElementById('api-inspect-drawer');
    if (!drawer) return;
    drawer.style.display = (drawer.style.display === 'none' || !drawer.style.display) ? 'block' : 'none';
  };

  // ── 1. Navigate from Categories Screen -> Category Drilldown Screen ──
  window.openCategoryDrilldown = async function(catId, catSlug, catName) {
    currentCategoryId   = catId;
    currentCategorySlug = catSlug || catId;
    currentCategoryName = catName;
    currentSubcategoryId = 'all';
    currentSubcategoryName = 'All Services';
    searchQuery = '';

    const searchInput = document.getElementById('bc-drilldown-search');
    if (searchInput) searchInput.value = '';

    // Switch visible screens
    document.getElementById('screen-categories-view').style.display = 'none';
    const drilldownScreen = document.getElementById('screen-category-drilldown');
    drilldownScreen.style.display = 'block';

    // Update Hero Banner in Drilldown
    const cardEl = document.querySelector(`.bc-cat-card[data-category-id="${catId}"]`);
    const bgImg = cardEl ? cardEl.dataset.categoryImg : '';
    const desc  = cardEl ? cardEl.dataset.categoryDesc : '';

    const heroBgEl    = document.getElementById('drilldown-cat-bg');
    const heroTitleEl = document.getElementById('drilldown-cat-title');
    const heroDescEl  = document.getElementById('drilldown-cat-desc');

    if (heroBgEl && bgImg) heroBgEl.src = bgImg;
    if (heroTitleEl) heroTitleEl.textContent = catName;
    if (heroDescEl)  heroDescEl.textContent  = desc || `Explore curated salon and wellness services in ${catName}.`;

    // Push URL state
    try {
      history.pushState({ categoryId: catId, categorySlug: currentCategorySlug }, '', '/services/' + currentCategorySlug);
    } catch(e) {}

    // Scroll to drilldown section smoothly
    drilldownScreen.scrollIntoView({ behavior: 'smooth', block: 'start' });

    // Trigger APIs
    await fetchSubcategories(catId);
    await fetchServices();
  };

  // ── 2. Back to All Categories ──
  window.backToCategoriesList = function() {
    currentCategoryId   = null;
    currentCategorySlug = null;
    currentSubcategoryId = 'all';
    searchQuery = '';

    document.getElementById('screen-category-drilldown').style.display = 'none';
    const catScreen = document.getElementById('screen-categories-view');
    catScreen.style.display = 'block';

    try {
      history.pushState(null, '', '/services');
    } catch(e) {}

    catScreen.scrollIntoView({ behavior: 'smooth', block: 'start' });

    // Update API display to reflect categories endpoint
    updateApiDisplay('GET', '/api/v1/categories', '200 OK', 'Categories View', { status: 'success', active_screen: 'categories' });
  };

  // ── 3. Subcategory Tab Click ──
  window.selectSubcategoryTab = async function(subId, subName) {
    currentSubcategoryId = subId;
    currentSubcategoryName = subName || 'All Services';
    searchQuery = '';

    const searchInput = document.getElementById('bc-drilldown-search');
    if (searchInput) searchInput.value = '';

    // Update tab active classes
    document.querySelectorAll('.bc-subcat-tab').forEach(tab => {
      tab.classList.toggle('active', tab.dataset.subcategoryId === subId);
    });

    const activeLabel = document.getElementById('active-tab-filter-label');
    if (activeLabel) {
      activeLabel.textContent = currentCategoryName + ' • ' + currentSubcategoryName;
    }

    await fetchServices();
  };

  // ── 4. City & Sort Handlers ──
  window.handleCityChange = async function(cityVal) {
    currentCityId = cityVal;
    await fetchServices();
  };

  window.handleSortChange = async function(sortVal) {
    currentSort = sortVal;
    await fetchServices();
  };

  // ── 5. In-Category Search Handler ──
  const drilldownSearchInput = document.getElementById('bc-drilldown-search');
  if (drilldownSearchInput) {
    drilldownSearchInput.addEventListener('input', function(e) {
      searchQuery = e.target.value.trim();
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(async () => {
        await fetchServices();
      }, 300);
    });
  }

  // ── API: Fetch Subcategories (Loads into Tab Form) ──
  async function fetchSubcategories(categoryId) {
    const tabsContainer = document.getElementById('bc-subcat-tabs-container');
    if (!tabsContainer) return;

    let endpoint = `/api/v1/subcategories?category_id=${categoryId}`;
    if (currentCityId !== 'all') endpoint += `&city_id=${currentCityId}`;

    // Show loading skeleton tabs
    tabsContainer.innerHTML = `
      <div class="bc-subcat-tab active">
        <i class="ti ti-loader animate-spin"></i> Loading subcategories...
      </div>
    `;

    try {
      const res = await fetch(endpoint, { headers: { 'Accept': 'application/json' } });
      const json = await res.json();
      const subcategories = json.data || [];

      let totalServices = 0;
      subcategories.forEach(s => { totalServices += (s.service_count || 0); });

      const countBadge = document.getElementById('drilldown-cat-count-badge');
      if (countBadge) countBadge.textContent = `${totalServices} Services`;

      updateApiDisplay('GET', endpoint, '200 OK', `${subcategories.length} subcategories`, json);

      // Render Subcategories in Tab Form
      let tabsHtml = `
        <button type="button" 
                class="bc-subcat-tab ${currentSubcategoryId === 'all' ? 'active' : ''}" 
                data-subcategory-id="all" 
                onclick="selectSubcategoryTab('all', 'All Services')">
          <i class="ti ti-layout-grid"></i>
          <span>All ${currentCategoryName || ''}</span>
          <span class="bc-subcat-tab-count">${totalServices}</span>
        </button>
      `;

      subcategories.forEach(sub => {
        tabsHtml += `
          <button type="button" 
                  class="bc-subcat-tab ${currentSubcategoryId === sub.id ? 'active' : ''}" 
                  data-subcategory-id="${sub.id}"
                  onclick="selectSubcategoryTab('${sub.id}', '${sub.name.replace(/'/g, "\\'")}')">
            <span>${sub.name}</span>
            <span class="bc-subcat-tab-count">${sub.service_count || 0}</span>
          </button>
        `;
      });

      tabsContainer.innerHTML = tabsHtml;
    } catch(err) {
      console.error('Error fetching subcategories:', err);
      tabsContainer.innerHTML = `<span class="text-danger small">Failed to load subcategories.</span>`;
    }
  }

  // ── API: Fetch Services (Loads into Cards Form) ──
  async function fetchServices() {
    const grid = document.getElementById('bc-services-grid');
    const countBadge = document.getElementById('visible-count');
    if (!grid) return;

    // Render Skeletons
    grid.innerHTML = `
      <div class="bc-svc-skeleton"><div class="bc-skel-img"></div><div class="bc-skel-body"><div class="bc-skel-line" style="width:40%;"></div><div class="bc-skel-line" style="width:80%;"></div><div class="bc-skel-line" style="width:60%;"></div></div></div>
      <div class="bc-svc-skeleton"><div class="bc-skel-img"></div><div class="bc-skel-body"><div class="bc-skel-line" style="width:40%;"></div><div class="bc-skel-line" style="width:80%;"></div><div class="bc-skel-line" style="width:60%;"></div></div></div>
      <div class="bc-svc-skeleton"><div class="bc-skel-img"></div><div class="bc-skel-body"><div class="bc-skel-line" style="width:40%;"></div><div class="bc-skel-line" style="width:80%;"></div><div class="bc-skel-line" style="width:60%;"></div></div></div>
    `;

    let endpoint = '/api/v1/services';
    const params = new URLSearchParams();

    if (searchQuery) {
      endpoint = '/api/v1/services/search';
      params.append('q', searchQuery);
      if (currentCategoryId) params.append('category_id', currentCategoryId);
      if (currentCityId !== 'all') params.append('city_id', currentCityId);
      params.append('limit', '50');
    } else {
      if (currentSubcategoryId !== 'all') {
        params.append('subcategory_id', currentSubcategoryId);
      } else if (currentCategoryId) {
        params.append('category_id', currentCategoryId);
      }
      if (currentCityId !== 'all') params.append('city_id', currentCityId);
      if (currentSort) params.append('sort', currentSort);
    }

    const qs = params.toString();
    const fullUrl = qs ? `${endpoint}?${qs}` : endpoint;

    try {
      const res = await fetch(fullUrl, { headers: { 'Accept': 'application/json' } });
      const json = await res.json();
      const services = json.data || [];

      if (countBadge) countBadge.textContent = services.length;

      updateApiDisplay('GET', fullUrl, '200 OK', `${services.length} services loaded`, json);

      if (services.length === 0) {
        grid.innerHTML = `
          <div class="bc-empty-catalog">
            <i class="ti ti-search-off"></i>
            <h3>No services found</h3>
            <p>Try switching to another subcategory tab or clearing the search.</p>
          </div>
        `;
        return;
      }

      let cardsHtml = '';
      services.forEach(svc => {
        const effPrice  = parseFloat(svc.effective_price || svc.base_price || 0).toFixed(0);
        const basePrice = parseFloat(svc.base_price || 0).toFixed(0);
        const onSale    = svc.on_sale || (parseFloat(basePrice) > parseFloat(effPrice));
        const imgSrc    = svc.image_url || '/slider/slide1.png';
        const catName   = svc.category ? svc.category.name : (currentCategoryName || 'Salon');
        const subName   = svc.subcategory ? svc.subcategory.name : 'Services';

        let badgeHtml = '';
        if (onSale && parseFloat(basePrice) > 0) {
          const discountPct = Math.round(((parseFloat(basePrice) - parseFloat(effPrice)) / parseFloat(basePrice)) * 100);
          badgeHtml = `<span class="bc-svc-badge">SAVE ${discountPct}%</span>`;
        } else if (svc.featured) {
          badgeHtml = `<span class="bc-svc-badge">FEATURED</span>`;
        }

        cardsHtml += `
          <div class="bc-svc-card" data-service-id="${svc.id}">
            ${badgeHtml}
            <div class="bc-svc-img-wrap">
              <img src="${imgSrc}" alt="${svc.name}" class="bc-svc-img" loading="lazy">
            </div>
            <div class="bc-svc-body">
              <span class="bc-svc-cat-tag">${catName} &bull; ${subName}</span>
              <h3>${svc.name}</h3>
              <p class="bc-svc-desc">${svc.description || 'Professional doorstep beauty service performed with certified hygienic single-use kits.'}</p>
              <div class="bc-svc-meta-row">
                <span class="bc-svc-duration"><i class="ti ti-clock"></i> ${svc.duration_minutes || 60} mins</span>
                <span class="bc-svc-rating"><i class="ti ti-star-filled"></i> 4.9 (80+)</span>
              </div>
              <div class="bc-svc-price-action">
                <div class="bc-svc-price-wrap">
                  ${onSale ? `<span class="bc-svc-orig-price">₹${basePrice}</span>` : ''}
                  <span class="bc-svc-final-price">₹${effPrice}</span>
                </div>
                <div class="bc-svc-btns-group">
                  <button type="button" class="bc-svc-info-btn" title="View Treatment Details" onclick="openServiceDetailsModal('${svc.id}')">
                    <i class="ti ti-info-circle"></i>
                  </button>
                  <button type="button" class="bc-svc-book-btn" onclick="handleBookService('${svc.id}', '${svc.name.replace(/'/g, "\\'")}', ${effPrice})">
                    <i class="ti ti-calendar-plus"></i> Book
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      });

      grid.innerHTML = cardsHtml;
    } catch(err) {
      console.error('Error fetching services:', err);
      grid.innerHTML = `
        <div class="bc-empty-catalog">
          <i class="ti ti-alert-triangle text-danger"></i>
          <h3>Failed to load services</h3>
          <p>Could not retrieve data from ${fullUrl}.</p>
        </div>
      `;
    }
  }

  // ── Quick-View Service Modal (Triggered by /api/v1/services/:id) ──
  window.openServiceDetailsModal = async function(serviceId) {
    const modal = document.getElementById('bc-svc-modal');
    if (!modal) return;

    modal.classList.add('open');
    document.body.style.overflow = 'hidden';

    // Show initial loading placeholders inside modal
    document.getElementById('modal-title').textContent = 'Loading treatment details...';
    document.getElementById('modal-cat').textContent   = 'BeautyNest';
    document.getElementById('modal-about').textContent = 'Connecting to service API...';
    document.getElementById('modal-price').textContent = '';
    document.getElementById('modal-duration').textContent = '';
    document.getElementById('modal-benefits').innerHTML = '<li><i class="ti ti-loader animate-spin"></i> <span>Fetching certified benefits...</span></li>';
    document.getElementById('modal-process').innerHTML  = '<li><i class="ti ti-loader animate-spin"></i> <span>Fetching step-by-step procedure...</span></li>';

    let endpoint = `/api/v1/services/${serviceId}`;
    if (currentCityId !== 'all') endpoint += `?city_id=${currentCityId}`;

    try {
      const res = await fetch(endpoint, { headers: { 'Accept': 'application/json' } });
      const json = await res.json();
      const svc = json.data;

      updateApiDisplay('GET', endpoint, '200 OK', `Service: ${svc.name}`, json);

      const effPrice  = parseFloat(svc.effective_price || svc.base_price || 0).toFixed(0);
      const basePrice = parseFloat(svc.base_price || 0).toFixed(0);
      const onSale    = svc.on_sale || (parseFloat(basePrice) > parseFloat(effPrice));

      document.getElementById('modal-title').textContent = svc.name;
      document.getElementById('modal-cat').textContent   = `${svc.category ? svc.category.name : 'Salon'} • ${svc.subcategory ? svc.subcategory.name : 'Services'}`;
      document.getElementById('modal-img').src           = svc.image_url || '/slider/slide1.png';
      document.getElementById('modal-price').textContent = '₹' + effPrice;
      document.getElementById('modal-duration').textContent = (svc.duration_minutes || 60) + ' mins';
      document.getElementById('modal-about').textContent = svc.about || svc.description || 'Indulge in a premium salon ritual delivered hygienically to your doorstep by certified beauty experts.';

      const basePriceEl = document.getElementById('modal-base-price');
      if (basePriceEl) {
        if (onSale) {
          basePriceEl.textContent = '₹' + basePrice;
          basePriceEl.style.display = 'block';
        } else {
          basePriceEl.style.display = 'none';
        }
      }

      // Benefits
      const benefitsList = document.getElementById('modal-benefits');
      benefitsList.innerHTML = '';
      const benefits = svc.benefits && svc.benefits.length ? svc.benefits : [
        "100% single-use disposable sanitized kit opened in front of you",
        "Performed by verified and background-cleared salon specialists",
        "Gentle, paraben-free and dermatologically-tested products",
        "Post-treatment maintenance guidance & radiant skin glow"
      ];
      benefits.forEach(b => {
        const li = document.createElement('li');
        li.innerHTML = `<i class="ti ti-check text-green"></i> <span>${b}</span>`;
        benefitsList.appendChild(li);
      });

      // Process
      const processList = document.getElementById('modal-process');
      processList.innerHTML = '';
      const process = svc.process && svc.process.length ? svc.process : [
        "1. Consultation & Skin / Hair Analysis",
        "2. Surface hygiene preparation & kit unsealing",
        "3. Core treatment & therapeutic massage",
        "4. Soothing finishing serum application"
      ];
      process.forEach(p => {
        const li = document.createElement('li');
        li.innerHTML = `<i class="ti ti-arrow-right text-indigo"></i> <span>${p}</span>`;
        processList.appendChild(li);
      });

      // Bind Book button in modal
      const bookBtn = document.getElementById('modal-book-btn');
      if (bookBtn) {
        bookBtn.onclick = function() {
          closeServiceModal();
          handleBookService(svc.id, svc.name, effPrice);
        };
      }
    } catch(err) {
      console.error('Error fetching service details:', err);
      document.getElementById('modal-title').textContent = 'Error Loading Treatment';
    }
  };

  window.closeServiceModal = function() {
    const modal = document.getElementById('bc-svc-modal');
    if (modal) {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
  };

  window.closeModalOnBackdrop = function(e) {
    if (e.target.id === 'bc-svc-modal') closeServiceModal();
  };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeServiceModal();
  });

  // ── Cart & Booking API Trigger ──
  window.handleBookService = async function(serviceId, serviceName, price) {
    const token = window.__CUSTOMER_TOKEN__ || localStorage.getItem('customerToken') || '';

    if (!token) {
      showToast('Please sign in to add items to your booking cart.', false);
      setTimeout(() => {
        window.location.href = '/login?return_to=' + encodeURIComponent(window.location.pathname);
      }, 1200);
      return;
    }

    const endpoint = '/api/v1/cart/items';
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          service_id: serviceId,
          quantity: 1
        })
      });

      const json = await res.json();
      updateApiDisplay('POST', endpoint, `${res.status} ${res.statusText || 'OK'}`, `Added ${serviceName}`, json);

      if (res.ok && json.status === 'success') {
        showToast(`✓ "${serviceName}" added to your booking cart!`);
      } else {
        const errorMsg = (json.errors && json.errors[0]) || json.message || 'Could not add to cart';
        showToast(errorMsg, false);
      }
    } catch(err) {
      console.error('Error adding to cart:', err);
      showToast(`Selected "${serviceName}" (₹${price}) for booking!`);
    }
  };

  // ── Browser History PopState (Back / Forward Support) ──
  window.addEventListener('popstate', function(e) {
    if (e.state && e.state.categoryId) {
      openCategoryDrilldown(e.state.categoryId, e.state.categorySlug, e.state.categoryName);
    } else {
      backToCategoriesList();
    }
  });

  // ── Auto-initialize if URL has category ──
  document.addEventListener('DOMContentLoaded', function() {
    if (window.__INITIAL_CATEGORY_ID__) {
      const initialCatCard = document.querySelector(`.bc-cat-card[data-category-id="${window.__INITIAL_CATEGORY_ID__}"]`) ||
                             document.querySelector(`.bc-cat-card[data-category-slug="${window.__INITIAL_CATEGORY_ID__}"]`);
      if (initialCatCard) {
        openCategoryDrilldown(
          initialCatCard.dataset.categoryId, 
          initialCatCard.dataset.categorySlug, 
          initialCatCard.dataset.categoryName
        );
      }
    }
  });
</script>
