<% content_for :page_title, "Services — Professional Beauty & Wellness at Home" %>

<%= render "shared/public_nav", active: "services" %>

<script>
  // Customer JWT token if logged in through Rails session
  window.__CUSTOMER_TOKEN__ = "<%= @customer_token.presence || '' %>";
  if (window.__CUSTOMER_TOKEN__) {
    try { localStorage.setItem('customerToken', window.__CUSTOMER_TOKEN__); } catch(e) {}
  }

  // Preloaded active category from URL if routed via /services/:category_id
  window.__INITIAL_CATEGORY_ID__ = "<%= @selected_category&.id || (@selected_category ? @selected_category.slug : (params[:category_id].presence || params[:category].presence || '')) %>";
  window.__INITIAL_CATEGORY_SLUG__ = "<%= @selected_category&.slug || '' %>";
  window.__INITIAL_CATEGORY_NAME__ = "<%= @selected_category&.name || '' %>";
</script>

<style>
  /* ====================================================
     BeautyNest Services & Dynamic API Explorer Styles
     ==================================================== */
  :root {
    --bn-pink: #db2777;
    --bn-pink-dark: #be185d;
    --bn-pink-light: #fdf2f8;
    --bn-pink-border: rgba(219, 39, 119, 0.2);
    --bn-card-border: rgba(0, 0, 0, 0.08);
  }

  .bc-catalog-wrapper {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Live Customer API Console Bar (Visible & Clear) ── */
  .bc-api-bar-wrap {
    margin: 1.5rem 0 2rem;
    position: relative;
    z-index: 100;
  }

  .bc-api-bar {
    background: #0f172a;
    color: #f8fafc;
    border-radius: 16px;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", monospace;
  }

  .bc-api-bar-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 0.84rem;
  }

  .bc-api-pulse-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.3);
    animation: bcApiPulse 1.8s infinite;
  }

  @keyframes bcApiPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.9); }
  }

  .bc-api-label {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .bc-api-badge-method {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.04em;
  }

  .bc-api-badge-method.post {
    background: #10b981;
  }

  .bc-api-endpoint {
    background: rgba(255, 255, 255, 0.1);
    color: #38bdf8;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.84rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    word-break: break-all;
  }

  .bc-api-bar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bc-api-status-badge {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 50px;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .bc-api-meta {
    font-size: 0.78rem;
    color: #94a3b8;
  }

  .bc-api-inspect-btn {
    background: rgba(255, 255, 255, 0.15);
    color: #f1f5f9;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 4px 12px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: all 0.15s ease;
  }

  .bc-api-inspect-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .bc-api-drawer {
    margin-top: 8px;
    background: #090d16;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1rem 1.25rem;
    animation: bcModalIn 0.18s ease;
  }

  .bc-api-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .bc-api-drawer-close {
    background: none;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    font-size: 1.1rem;
  }

  .bc-api-drawer-close:hover {
    color: #ffffff;
  }

  .bc-api-json {
    max-height: 240px;
    overflow-y: auto;
    font-size: 0.78rem;
    color: #e2e8f0;
    background: #020617;
    padding: 10px;
    border-radius: 8px;
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* ── Screen 1: Categories View ── */
  .bc-category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 18px;
    margin-top: 1.5rem;
  }

  .bc-cat-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #ffffff;
    border: 1.5px solid var(--bn-card-border);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
    cursor: pointer;
    transition: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    height: 200px;
    text-align: left;
    user-select: none;
  }

  .bc-cat-card:hover {
    transform: translateY(-6px);
    border-color: var(--bn-pink);
    box-shadow: 0 16px 36px rgba(219, 39, 119, 0.16);
  }

  .bc-cat-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .bc-cat-card:hover .bc-cat-card-img {
    transform: scale(1.08);
  }

  .bc-cat-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 10, 30, 0.1) 0%, rgba(15, 10, 30, 0.88) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
    color: #ffffff;
    z-index: 2;
  }

  .bc-cat-card-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    z-index: 3;
  }

  .bc-cat-card-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: #ffffff;
    margin-bottom: 8px;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .bc-cat-card-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 4px;
    line-height: 1.25;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
  }

  .bc-cat-card-desc {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 8px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bc-cat-card-action {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #f472b6;
    letter-spacing: 0.02em;
  }

  /* ── Screen 2: Category Drilldown View (Subcategories Tabs + Services) ── */
  .bc-drilldown-header {
    margin-bottom: 2rem;
  }

  .bc-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px;
    border-radius: 50px;
    background: #ffffff;
    color: #374151;
    font-size: 0.88rem;
    font-weight: 700;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    margin-bottom: 1.5rem;
  }

  .bc-back-btn:hover {
    border-color: var(--bn-pink);
    color: var(--bn-pink);
    transform: translateX(-3px);
  }

  /* Category Hero Banner in Drilldown */
  .bc-category-hero-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    height: 180px;
    margin-bottom: 2rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .bc-cat-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bc-cat-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 10, 30, 0.92) 0%, rgba(15, 10, 30, 0.6) 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 2.5rem;
    color: #ffffff;
  }

  .bc-cat-hero-info h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  .bc-cat-hero-info p {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    max-width: 540px;
    line-height: 1.5;
  }

  /* ── Subcategories in TAB Form (Requested by User) ── */
  .bc-subcat-tabs-container {
    background: #ffffff;
    border-radius: 20px;
    padding: 8px 12px;
    border: 1px solid var(--bn-card-border);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .bc-subcat-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 14px;
    border: 1.5px solid transparent;
    background: transparent;
    color: #475569;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bc-subcat-tab:hover {
    color: var(--bn-pink);
    background: var(--bn-pink-light);
  }

  .bc-subcat-tab.active {
    background: linear-gradient(135deg, var(--bn-pink), var(--bn-pink-dark));
    color: #ffffff;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(219, 39, 119, 0.28);
  }

  .bc-subcat-tab-count {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 800;
    background: rgba(0, 0, 0, 0.06);
    color: inherit;
  }

  .bc-subcat-tab.active .bc-subcat-tab-count {
    background: rgba(255, 255, 255, 0.28);
    color: #ffffff;
  }

  /* ── Filter & Search Toolbar in Drilldown ── */
  .bc-drilldown-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .bc-drilldown-search-box {
    position: relative;
    flex: 1 1 280px;
    max-width: 420px;
  }

  .bc-drilldown-search-box input {
    width: 100%;
    padding: 11px 16px 11px 40px;
    border-radius: 50px;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    font-size: 0.88rem;
    background: #ffffff;
    outline: none;
    transition: all 0.2s ease;
  }

  .bc-drilldown-search-box input:focus {
    border-color: var(--bn-pink);
    box-shadow: 0 0 0 3px rgba(219, 39, 119, 0.15);
  }

  .bc-drilldown-search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    font-size: 1.1rem;
  }

  .bc-drilldown-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ── Services in Card Format ── */
  .bc-services-full {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.5rem;
  }

  .bc-svc-card {
    position: relative;
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid var(--bn-card-border);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s ease;
  }

  .bc-svc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px rgba(219, 39, 119, 0.12);
  }

  .bc-svc-img-wrap {
    position: relative;
    width: 100%;
    height: 195px;
    overflow: hidden;
    background: linear-gradient(135deg, #fdf2f8, #fce7f3);
  }

  .bc-svc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .bc-svc-card:hover .bc-svc-img {
    transform: scale(1.06);
  }

  .bc-svc-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(219, 39, 119, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 50px;
    z-index: 2;
  }

  .bc-svc-body {
    padding: 1.25rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .bc-svc-cat-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--bn-pink);
    margin-bottom: 6px;
    display: block;
  }

  .bc-svc-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 6px;
    line-height: 1.35;
  }

  .bc-svc-desc {
    font-size: 0.83rem;
    color: #64748b;
    line-height: 1.55;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .bc-svc-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-top: 1px dashed rgba(0, 0, 0, 0.08);
    margin-bottom: 12px;
    font-size: 0.8rem;
    color: #64748b;
  }

  .bc-svc-duration {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

  .bc-svc-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #b45309;
    font-weight: 700;
  }

  .bc-svc-price-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
  }

  .bc-svc-price-wrap {
    display: flex;
    flex-direction: column;
  }

  .bc-svc-orig-price {
    font-size: 0.78rem;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .bc-svc-final-price {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--bn-pink);
    line-height: 1;
  }

  .bc-svc-btns-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .bc-svc-info-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    background: #ffffff;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.16s ease;
    font-size: 1.1rem;
  }

  .bc-svc-info-btn:hover {
    border-color: var(--bn-pink);
    color: var(--bn-pink);
    background: var(--bn-pink-light);
  }

  .bc-svc-book-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--bn-pink), var(--bn-pink-dark));
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(219, 39, 119, 0.25);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bc-svc-book-btn:hover {
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(219, 39, 119, 0.4);
  }

  /* Skeleton Loading State */
  .bc-svc-skeleton {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid var(--bn-card-border);
    height: 380px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: bcPulse 1.2s infinite ease-in-out;
  }

  @keyframes bcPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 0.95; }
  }

  .bc-skel-img {
    height: 195px;
    background: #f1f5f9;
  }

  .bc-skel-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .bc-skel-line {
    height: 12px;
    border-radius: 6px;
    background: #e2e8f0;
  }

  /* Quick View Modal */
  .bc-modal-backdrop {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 10, 30, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .bc-modal-backdrop.open {
    display: flex;
  }

  .bc-modal-card {
    background: #ffffff;
    border-radius: 24px;
    max-width: 640px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
    position: relative;
    display: flex;
    flex-direction: column;
    animation: bcModalIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes bcModalIn {
    from { opacity: 0; transform: scale(0.96) translateY(12px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  .bc-modal-header {
    position: relative;
    height: 220px;
    background: linear-gradient(135deg, #fdf2f8, #fce7f3);
    overflow: hidden;
  }

  .bc-modal-header img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bc-modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.2rem;
    transition: background 0.15s ease;
    z-index: 10;
  }

  .bc-modal-close:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  .bc-modal-body {
    padding: 1.75rem;
  }

  .bc-modal-badge {
    display: inline-block;
    background: #fdf2f8;
    color: var(--bn-pink);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: 50px;
    margin-bottom: 8px;
  }

  .bc-modal-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 8px;
  }

  .bc-modal-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    color: #64748b;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    flex-wrap: wrap;
  }

  .bc-modal-section-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111827;
    margin: 1.25rem 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .bc-modal-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bc-modal-list li {
    font-size: 0.85rem;
    color: #4b5563;
    display: flex;
    align-items: flex-start;
