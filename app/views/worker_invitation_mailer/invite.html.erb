<div class="card">
  <div style="text-align: center; margin-bottom: 24px;">
    <h1 style="color: #db2777; margin: 0; font-size: 24px; font-weight: 700;"><%= @site_name %></h1>
    <p style="color: #94a3b8; font-size: 14px; margin-top: 4px;">Service Professional Onboarding</p>
  </div>

  <p style="font-size: 16px; line-height: 1.5;">Hello <%= @invitation.name.presence || "Partner" %>,</p>

  <p style="font-size: 15px; line-height: 1.6; color: #cbd5e1;">
    <strong><%= @invited_by&.name || "The #{@site_name} Team" %></strong> has invited you to join <%= @site_name %> as a verified beauty & wellness service professional.
  </p>

  <% if @invitation.speciality.present? || @invitation.city.present? %>
    <div style="background-color: #0f172a; border-radius: 8px; padding: 14px 18px; margin: 16px 0; border: 1px solid #334155;">
      <% if @invitation.speciality.present? %>
        <p style="margin: 0 0 6px 0; font-size: 13px; color: #94a3b8;">
          <strong style="color: #f8fafc;">Speciality:</strong> <%= @invitation.speciality %>
        </p>
      <% end %>
      <% if @invitation.city.present? %>
        <p style="margin: 0; font-size: 13px; color: #94a3b8;">
          <strong style="color: #f8fafc;">Operating City:</strong> <%= @invitation.city.name %>
        </p>
      <% end %>
    </div>
  <% end %>

  <p style="font-size: 15px; line-height: 1.6; color: #cbd5e1;">
    Click the button below to accept your invitation, complete your profile, and start accepting customer bookings:
  </p>

  <div style="text-align: center; margin: 28px 0;">
    <a href="<%= @accept_url %>" class="btn" style="color: #ffffff; text-decoration: none;">
      Accept & Complete Profile
    </a>
  </div>

  <p style="font-size: 13px; color: #94a3b8; line-height: 1.5;">
    This invitation link is valid for <strong>7 days</strong> (expires on <%= @invitation.expires_at.strftime("%B %d, %Y") %>).
  </p>

  <hr style="border: 0; border-top: 1px solid #334155; margin: 24px 0;">

  <p style="font-size: 12px; color: #64748b; word-break: break-all;">
    If the button doesn't work, copy and paste this link into your browser:<br>
    <a href="<%= @accept_url %>" style="color: #db2777;"><%= @accept_url %></a>
  </p>
</div>
