<% content_for :page_title, "Invite Worker" %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">
        <%= link_to "Workers", admin_workers_path, class: "text-decoration-none text-secondary" %> / 
        <%= link_to "Invitations", admin_worker_invitations_path, class: "text-decoration-none text-secondary" %>
      </div>
      <h2 class="page-title fs-1 fw-bold">Invite Service Professional</h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <%= link_to admin_worker_invitations_path, class: "btn btn-outline-secondary" do %>
        <i class="ti ti-arrow-left me-1 fs-3"></i> Back to Invitations
      <% end %>
    </div>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header border-bottom py-3">
        <h3 class="card-title">Worker Invitation Details</h3>
      </div>
      
      <%= form_with model: [:admin, @invitation], local: true do |f| %>
        <div class="card-body">
          <% if @invitation.errors.any? %>
            <div class="alert alert-danger mb-4" role="alert">
              <div class="d-flex align-items-center mb-2">
                <i class="ti ti-alert-circle fs-2 me-2"></i>
                <h4 class="alert-title mb-0">Please fix the following errors:</h4>
              </div>
              <ul class="mb-0 ps-3">
                <% @invitation.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="alert alert-info d-flex align-items-start mb-4">
            <i class="ti ti-info-circle fs-2 me-2 flex-shrink-0 mt-1"></i>
            <div>
              An invitation email containing a secure 7-day registration link will be sent to the worker. Upon opening the link, they will configure their password, Aadhaar/KYC details, and services to activate their account.
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <%= f.label :name, "Worker Full Name", class: "form-label required" %>
              <div class="input-icon">
                <span class="input-icon-addon">
                  <i class="ti ti-user text-secondary fs-3"></i>
                </span>
                <%= f.text_field :name, class: "form-control", placeholder: "e.g. Priya Sharma", required: true %>
              </div>
            </div>

            <div class="col-md-6">
              <%= f.label :email, "Worker Email Address", class: "form-label required" %>
              <div class="input-icon">
                <span class="input-icon-addon">
                  <i class="ti ti-mail text-secondary fs-3"></i>
                </span>
                <%= f.email_field :email, class: "form-control", placeholder: "beautician@example.com", required: true %>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :speciality, "Primary Skill", class: "form-label" %>
            <div class="input-icon">
              <span class="input-icon-addon">
                <i class="ti ti-sparkles text-secondary fs-3"></i>
              </span>
              <%= f.text_field :speciality, class: "form-control", placeholder: "e.g. Facial & Skin Care, Bridal Makeup, Hair Styling" %>
            </div>
            <small class="form-hint">Specify the main specialty or service expertise of the professional.</small>
          </div>
        </div>

        <div class="card-footer d-flex justify-content-between border-top py-3">
          <%= link_to "Cancel", admin_worker_invitations_path, class: "btn btn-outline-secondary" %>
          <%= f.button type: :submit, class: "btn btn-primary" do %>
            <i class="ti ti-send me-1 fs-3"></i> Send Worker Invitation
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
