<% content_for :page_title, "Review ##{@review[:id]}" %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">Feedback Moderation</div>
      <h2 class="page-title fs-1 fw-bold">Review #<%= @review[:id] %></h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="btn-list">
        <%= link_to admin_reviews_path, class: "btn btn-outline-secondary" do %>
          <i class="ti ti-arrow-left me-1 fs-3"></i> Back
        <% end %>
        <%= link_to edit_admin_review_path(@review[:id]), class: "btn btn-primary" do %>
          <i class="ti ti-edit me-1 fs-3"></i> Moderate Review
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold mb-0">Customer Feedback</h3>
        <div><%= review_status_badge(@review[:status]) %></div>
      </div>
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div class="fs-1 fw-bold text-reset me-3"><%= @review[:rating] %>.0</div>
          <div><%= stars_html(@review[:rating]) %></div>
        </div>

        <blockquote class="blockquote bg-surface-secondary border p-4 rounded-3 text-reset fs-3 fst-italic mb-4">
          &ldquo;<%= @review[:comment] %>&rdquo;
        </blockquote>

        <div class="row g-3">
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Customer</div>
              <div class="fw-semibold text-reset mt-1"><%= @review[:customer] %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Service Specialist</div>
              <div class="fw-semibold text-reset mt-1"><%= @review[:worker] %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Service Category</div>
              <div class="fw-semibold text-reset mt-1"><%= @review[:service] %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Submission Date</div>
              <div class="fw-semibold text-reset mt-1">
                <i class="ti ti-calendar me-1"></i><%= @review[:date] %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom">
        <h3 class="card-title fw-bold">Moderation Actions</h3>
      </div>
      <div class="card-body d-flex flex-column gap-2">
        <button class="btn btn-outline-success w-100">
          <i class="ti ti-check me-1 fs-3"></i> Approve & Publish
        </button>
        <button class="btn btn-outline-danger w-100">
          <i class="ti ti-eye-off me-1 fs-3"></i> Hide from Public View
        </button>
      </div>
    </div>
  </div>
</div>
