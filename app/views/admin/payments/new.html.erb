<% content_for :page_title, "Record New Payment" %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">Financial Operations</div>
      <h2 class="page-title fs-1 fw-bold">Record Payment</h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <%= link_to admin_payments_path, class: "btn btn-outline-secondary" do %>
        <i class="ti ti-arrow-left me-1 fs-3"></i> Back to Ledger
      <% end %>
    </div>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header border-bottom">
        <h3 class="card-title fw-bold mb-0">Payment Details</h3>
      </div>
      <%= form_with model: [:admin, @payment], local: true do |f| %>
        <div class="card-body">
          <% if @payment.errors.any? %>
            <div class="alert alert-danger mb-3">
              <ul class="mb-0">
                <% @payment.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="row g-3 mb-3">
            <div class="col-md-12">
              <label class="form-label required">Associated Booking</label>
              <%= f.collection_select :booking_id, @bookings, :id, ->(b) { "Booking ##{b.id.to_s[0..7]} — #{b.customer_name} (#{b.display_amount})" }, { prompt: "Select a booking" }, { class: "form-select", required: true } %>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label required">Amount (₹)</label>
              <%= f.number_field :amount, step: 0.01, class: "form-control", placeholder: "e.g. 1499.00", required: true %>
            </div>
            <div class="col-md-6">
              <label class="form-label required">Transaction Reference</label>
              <%= f.text_field :transaction_ref, class: "form-control", placeholder: "e.g. UPI-TXN-123456" %>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label required">Payment Method</label>
              <%= f.select :method, Payment::METHODS.map { |m| [m.upcase, m] }, {}, class: "form-select", required: true %>
            </div>
            <div class="col-md-6">
              <label class="form-label required">Transaction Status</label>
              <%= f.select :status, Payment::STATUSES.map { |s| [s.titleize, s] }, {}, class: "form-select", required: true %>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label">Payment Timestamp</label>
              <%= f.datetime_local_field :paid_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"), class: "form-control" %>
            </div>
          </div>
        </div>

        <div class="card-footer border-top d-flex justify-content-between align-items-center bg-transparent">
          <%= link_to "Cancel", admin_payments_path, class: "btn btn-link link-secondary" %>
          <button type="submit" class="btn btn-primary">
            <i class="ti ti-check me-1 fs-3"></i> Record Payment
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
