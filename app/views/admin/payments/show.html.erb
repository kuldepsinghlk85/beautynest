<% content_for :page_title, "Payment #{@payment[:id]}" %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">Transaction Record</div>
      <h2 class="page-title fs-1 fw-bold">Payment <%= @payment[:id] %></h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="btn-list">
        <%= link_to admin_payments_path, class: "btn btn-outline-secondary" do %>
          <i class="ti ti-arrow-left me-1 fs-3"></i> Back
        <% end %>
        <%= link_to edit_admin_payment_path(@payment[:id]), class: "btn btn-primary" do %>
          <i class="ti ti-edit me-1 fs-3"></i> Update Status
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold mb-0">Transaction Information</h3>
        <div><%= payment_status_badge(@payment[:status]) %></div>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Gross Amount</div>
              <div class="fw-bold fs-2 text-success mt-1"><%= @payment[:amount] %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Payment Method</div>
              <div class="fw-semibold text-reset mt-1">
                <i class="ti ti-credit-card me-1"></i><%= @payment[:method] %>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Customer Account</div>
              <div class="fw-semibold text-reset mt-1"><%= @payment[:customer] %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Linked Booking</div>
              <div class="font-monospace fs-4 mt-1">
                <%= link_to @payment[:booking_id], admin_booking_path(@payment[:booking_id]), class: "link-primary" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom">
        <h3 class="card-title fw-bold">Actions & Receipt</h3>
      </div>
      <div class="card-body d-flex flex-column gap-2">
        <button class="btn btn-outline-secondary w-100">
          <i class="ti ti-printer me-1 fs-3"></i> Print Payment Receipt
        </button>
        <% if @payment[:status] == "completed" %>
          <button class="btn btn-outline-danger w-100">
            <i class="ti ti-rotate-ccw me-1 fs-3"></i> Issue Refund
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>
