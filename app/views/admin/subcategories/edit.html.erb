<% content_for :page_title, "Edit #{@subcategory.name}" %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">Catalog › Subcategories</div>
      <h2 class="page-title fs-1 fw-bold">Edit <%= @subcategory.name %></h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <%= link_to admin_subcategory_path(@subcategory), class: "btn btn-outline-secondary" do %>
        <i class="ti ti-arrow-left me-1 fs-3"></i> Back
      <% end %>
    </div>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <%= render "form", subcategory: @subcategory %>
  </div>
</div>
