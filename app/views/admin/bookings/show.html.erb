<% content_for :page_title, "Booking #{@booking.display_id}" %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">Booking Details</div>
      <h2 class="page-title fs-1 fw-bold">Booking #<%= @booking.display_id %></h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="btn-list align-items-center">
        <%= link_to admin_bookings_path, class: "btn btn-outline-secondary" do %>
          <i class="ti ti-arrow-left me-1 fs-3"></i> Back
        <% end %>
        <% is_assigned_worker = current_user&.worker? && @booking.worker_id.to_s == current_user.id.to_s %>
        <% if is_assigned_worker && @booking.booking_status == "pending" %>
          <%= button_to accept_admin_booking_path(@booking.id), method: :patch, class: "btn btn-success", data: { turbo_confirm: "Are you sure you want to accept this booking?", confirm_title: "Accept Booking", confirm_btn: "Accept Booking", confirm_theme: "success" } do %>
            <i class="ti ti-check me-1 fs-3"></i> Accept Booking
          <% end %>
          <%= button_to reject_admin_booking_path(@booking.id), method: :patch, class: "btn btn-danger", data: { turbo_confirm: "Are you sure you want to reject this booking?", confirm_title: "Reject Booking", confirm_btn: "Reject Booking" } do %>
            <i class="ti ti-x me-1 fs-3"></i> Reject Booking
          <% end %>
        <% end %>
        <% if (is_assigned_worker || current_user&.admin?) && !%w[cancelled rejected].include?(@booking.booking_status) %>
          <% if @booking.service_status != "completed" %>
            <%= button_to complete_service_admin_booking_path(@booking.id), method: :patch, class: "btn btn-success", data: { turbo_confirm: "Confirm that this service has been fully completed for customer #{@booking.customer_name}?" } do %>
              <i class="ti ti-check-double me-1 fs-3"></i> Complete Service
            <% end %>
          <% end %>
          <% if @booking.payment_status != "completed" %>
            <%= button_to complete_payment_admin_booking_path(@booking.id), method: :patch, class: "btn btn-outline-primary", data: { turbo_confirm: "Confirm payment of #{@booking.display_amount} received from customer?" } do %>
              <i class="ti ti-cash me-1 fs-3"></i> Mark Payment Received
            <% end %>
          <% end %>
        <% end %>
        <% if current_user&.admin? %>
          <%= link_to edit_admin_booking_path(@booking[:id]), class: "btn btn-primary" do %>
            <i class="ti ti-edit me-1 fs-3"></i> Manage Booking
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @booking.has_pending_reschedule_request? %>
  <% req = @booking.pending_reschedule_request %>
  <div class="card border-warning shadow-sm mb-4" style="background: rgba(245, 158, 11, 0.05); border-left: 4px solid #f59e0b !important;">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex align-items-start gap-3 flex-wrap">
        <div class="avatar avatar-md rounded-circle bg-warning-lt text-warning flex-shrink-0">
          <i class="ti ti-alert-triangle fs-1"></i>
        </div>

        <div class="flex-grow-1 min-w-0">
          <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
            <h3 class="fw-bold text-reset mb-0 fs-2">⚠️ Specialist Cannot Reach Alert & Reschedule Request</h3>
            <span class="badge bg-warning text-dark fw-bold">Action Required</span>
          </div>

          <p class="text-reset mb-2">
            Specialist <strong><%= @booking.worker&.name %></strong> reported that she <strong>cannot reach this appointment on time</strong>.
          </p>

          <div class="p-3 bg-surface rounded border mb-3">
            <div class="row g-2">
              <div class="col-sm-6">
                <div class="text-secondary small">Reported Reason:</div>
                <div class="fw-semibold text-danger">"<%= req.reason %>"</div>
              </div>
              <div class="col-sm-3">
                <div class="text-secondary small">Current Appointment:</div>
                <div class="fw-semibold text-reset"><%= @booking.display_date %> • <%= @booking.display_time %></div>
              </div>
              <div class="col-sm-3">
                <div class="text-secondary small">Requested Slot:</div>
                <div class="fw-semibold text-primary">
                  <%= req.requested_date ? req.requested_date.strftime("%d %b %Y") : "Same Day" %>
                  <%= req.requested_time_slot.presence || "(Admin Decision)" %>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="d-flex flex-wrap gap-2">
            <!-- Modal 1: Approve Slot Change -->
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-approve-reschedule">
              <i class="ti ti-calendar-time me-1"></i> Reschedule / Change Slot
            </button>

            <!-- Modal 2: Reassign to Another Beautician -->
            <button type="button" class="btn btn-warning text-dark" data-bs-toggle="modal" data-bs-target="#modal-reassign-reschedule">
              <i class="ti ti-user-exclamation me-1"></i> Reassign to Another Beautician
            </button>

            <!-- Modal 3: Decline / Reject Request -->
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modal-reject-reschedule">
              <i class="ti ti-x me-1"></i> Dismiss / Decline Request
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Reschedule Slot -->
  <div class="modal modal-blur fade" id="modal-approve-reschedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <%= form_with url: approve_reschedule_admin_booking_path(@booking), method: :post do %>
          <input type="hidden" name="request_id" value="<%= req.id %>">
          <div class="modal-header">
            <h5 class="modal-title fw-bold"><i class="ti ti-calendar-time text-primary me-1"></i> Reschedule Booking Slot</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-secondary small mb-3">
              Change the scheduled date and time slot for booking <strong>#<%= @booking.display_id %></strong>. The customer and worker will be notified automatically.
            </p>
            <div class="mb-3">
              <label class="form-label fw-bold">New Booking Date</label>
              <input type="date" name="date" class="form-control" value="<%= req.requested_date || @booking.date %>" required min="<%= Date.current %>">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">New Time Slot</label>
              <select name="time_slot" class="form-select" required>
                <% BookingAvailabilityService::STANDARD_TIME_SLOTS.each do |slot_info| %>
                  <% is_sel = (req.requested_time_slot == slot_info[:slot]) || (req.requested_time_slot.blank? && @booking.time_slot == slot_info[:slot]) %>
                  <option value="<%= slot_info[:slot] %>" <%= 'selected' if is_sel %>><%= slot_info[:slot] %> (<%= slot_info[:period].capitalize %>)</option>
                <% end %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Admin Notes (Optional)</label>
              <input type="text" name="admin_notes" class="form-control" placeholder="e.g. Rescheduled as requested by specialist due to traffic">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Confirm Slot Change</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Modal: Reassign Worker -->
  <div class="modal modal-blur fade" id="modal-reassign-reschedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <%= form_with url: reassign_reschedule_admin_booking_path(@booking), method: :post do %>
          <input type="hidden" name="request_id" value="<%= req.id %>">
          <div class="modal-header">
            <h5 class="modal-title fw-bold"><i class="ti ti-user-exclamation text-warning me-1"></i> Reassign to Another Beautician</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-secondary small mb-3">
              Reassign booking <strong>#<%= @booking.display_id %></strong> to another specialist who is available in <strong><%= @booking.serving_city %></strong> on <strong><%= @booking.display_date %> at <%= @booking.display_time %></strong>.
            </p>
            <div class="mb-3">
              <label class="form-label fw-bold">Select Available Specialist</label>
              <% if @eligible_replacement_workers.any? %>
                <select name="new_worker_id" class="form-select" required>
                  <option value="">-- Choose Replacement Specialist --</option>
                  <% @eligible_replacement_workers.each do |w| %>
                    <option value="<%= w.id %>"><%= w.name %> (★ <%= sprintf('%.1f', w.worker_profile&.rating_avg.to_f) %> • <%= w.serving_city %>)</option>
                  <% end %>
                </select>
              <% else %>
                <div class="alert alert-warning mb-0 small">
                  <i class="ti ti-alert-circle me-1"></i> No other specialists are currently free for this exact slot in <%= @booking.serving_city %>. Consider rescheduling the slot instead.
                </div>
              <% end %>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Admin Notes</label>
              <input type="text" name="admin_notes" class="form-control" placeholder="e.g. Reassigned to ensure on-time doorstep service">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning text-dark" <%= 'disabled' if @eligible_replacement_workers.empty? %>>Confirm Reassignment</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Modal: Reject Request -->
  <div class="modal modal-blur fade" id="modal-reject-reschedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
      <div class="modal-content">
        <%= form_with url: reject_reschedule_admin_booking_path(@booking), method: :post do %>
          <input type="hidden" name="request_id" value="<%= req.id %>">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">Decline Request</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-secondary small mb-3">
              Decline the slot change request and keep the current specialist assignment.
            </p>
            <div class="mb-3">
              <label class="form-label fw-bold">Reason for Declining</label>
              <textarea name="admin_notes" class="form-control" rows="2" placeholder="e.g. Customer cannot reschedule; please proceed" required></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">Decline Request</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom">
        <h3 class="card-title fw-bold mb-0">Booking Information</h3>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Service Requested</div>
              <div class="fw-bold fs-3 text-reset mt-1"><%= @booking[:service] %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Total Amount</div>
              <div class="fw-bold fs-3 text-success mt-1"><%= @booking[:amount] %></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Scheduled Date & Time</div>
              <div class="fw-semibold text-reset mt-1">
                <i class="ti ti-calendar me-1"></i><%= @booking[:date] %> &bull; <i class="ti ti-clock ms-1 me-1"></i><%= @booking[:time] %>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="card card-sm bg-surface-secondary border p-3">
              <div class="text-secondary small">Payment Status</div>
              <div class="mt-1"><%= payment_status_badge(@booking[:payment_status]) %></div>
            </div>
          </div>
        </div>

        <div class="hr-text text-secondary my-4">Stakeholders</div>

        <div class="row g-3">
          <div class="col-sm-6">
            <div class="card card-sm border p-3">
              <div class="text-secondary small mb-2">Customer</div>
              <div class="d-flex align-items-center">
                <span class="avatar avatar-md rounded-circle bg-azure-lt text-azure me-3 fw-bold">
                  <%= @booking[:customer].to_s[0..1].upcase %>
                </span>
                <div>
                  <div class="fw-bold text-reset"><%= @booking[:customer] %></div>
                  <div class="text-secondary small">ID: #<%= @booking[:customer_id] %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-sm-6">
            <div class="card card-sm border p-3">
              <div class="text-secondary small mb-2">Assigned Specialist</div>
              <div class="d-flex align-items-center">
                <span class="avatar avatar-md rounded-circle bg-indigo-lt text-indigo me-3 fw-bold">
                  <i class="ti ti-user fs-2"></i>
                </span>
                <div>
                  <% if @booking[:worker] == "Unassigned" %>
                    <span class="badge bg-warning-lt">Unassigned</span>
                  <% else %>
                    <div class="fw-bold text-reset"><%= @booking[:worker] %></div>
                    <div class="text-secondary small">Service Partner</div>
                    <% tier = @booking.worker_tier || @booking.worker&.worker_profile&.worker_tier %>
                    <% if tier %>
                      <% badge_color = case tier.slug
                                       when "gold"   then "warning"
                                       when "silver" then "secondary"
                                       else "orange"
                                       end %>
                      <div class="mt-1">
                        <span class="badge bg-<%= badge_color %>-lt fw-bold">
                          <i class="ti ti-award me-1"></i><%= tier.name %> Tier (<%= '%.2f' % tier.price_multiplier %>x)
                        </span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Original Booked Services Card -->
    <div class="card mb-4" style="border-radius:14px;border:1px solid var(--border);box-shadow:var(--shadow-md);overflow:hidden;">
      <div class="card-header border-bottom d-flex align-items-center justify-content-between py-3 px-4">
        <div class="d-flex align-items-center gap-2">
          <div style="width:36px;height:36px;border-radius:9px;background:rgba(99,102,241,0.12);display:flex;align-items:center;justify-content:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="mb-0 fw-bold fs-4">Original Booked Services</h3>
        </div>
        <span class="badge bg-indigo-lt fw-semibold px-3 py-2"><%= @booking_items.count %> <%= 'Item'.pluralize(@booking_items.count) %></span>
      </div>
      <div class="px-4 py-3">
        <%# Use @booking_items.sum as the ground truth — @booking.subtotal_amount
            and discount_amount can both be mutated by extra charge approvals. %>
        <% orig_subtotal  = @booking_items.sum(&:line_total).to_f %>
        <% orig_discount  = @booking.coupon ? @booking.coupon.apply_to(orig_subtotal) : 0.0 %>
        <% @booking_items.each do |item| %>
          <% item_discount = orig_discount > 0 && orig_subtotal > 0 ? ((item.line_total.to_f / orig_subtotal) * orig_discount).round(2) : 0.0 %>
          <% unit_discount = item.quantity.to_i > 0 ? (item_discount / item.quantity).round(2) : 0.0 %>
          <div class="d-flex align-items-center gap-3 py-3 border-bottom">
            <!-- Icon -->
            <div style="width:36px;height:36px;border-radius:9px;background:rgba(99,102,241,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            </div>

            <!-- Description & meta -->
            <div class="flex-fill">
              <div class="fw-semibold text-reset" style="font-size:14px;"><%= item.service_name_snapshot %></div>
              <div class="text-secondary" style="font-size:12px;">
                Service &bull; <i class="ti ti-clock me-1"></i><%= item.duration_minutes_snapshot %> mins &bull; Qty <%= item.quantity %> &bull;
                <% if unit_discount > 0 %>
                  <span class="text-decoration-line-through">₹<%= item.price_snapshot.to_i %></span>
                  <span class="text-success fw-semibold">₹<%= (item.price_snapshot.to_f - unit_discount).round(2) %></span> each
                <% else %>
                  ₹<%= item.price_snapshot.to_i %> each
                <% end %>
              </div>
            </div>

            <!-- Line total -->
            <div class="text-end" style="min-width:80px;">
              <% if item_discount > 0 %>
                <div class="text-decoration-line-through text-secondary" style="font-size:11px;">₹<%= item.line_total.to_i %></div>
                <div class="fw-bold text-success" style="font-size:15px;">₹<%= (item.line_total.to_f - item_discount).round(2) %></div>
                <span class="badge bg-danger-lt fw-bold" style="font-size:10px;">(₹<%= item_discount %> OFF)</span>
              <% else %>
                <div class="fw-bold text-reset" style="font-size:15px;">₹<%= item.line_total.to_i %></div>
              <% end %>
            </div>

            <!-- Status badge -->
            <div style="min-width:90px;text-align:right;">
              <span class="badge bg-indigo-lt">Booked</span>
            </div>
          </div>
        <% end %>

        <!-- Subtotal row -->
        <div class="d-flex justify-content-between align-items-center pt-3 pb-1">
          <span class="text-secondary small fw-medium">Services Subtotal</span>
          <div class="text-end">
            <% if orig_discount > 0 %>
              <span class="text-decoration-line-through text-secondary small me-1" style="font-size:11px;">₹<%= orig_subtotal.to_i %></span>
              <span class="fw-bold text-success fs-4">₹<%= (orig_subtotal - orig_discount).round(2) %></span>
              <% if @booking.coupon %>
                <div class="text-secondary" style="font-size:11px;"><i class="ti ti-tag me-1 text-danger"></i><%= @booking.coupon.code %> applied</div>
              <% end %>
            <% else %>
              <span class="fw-bold fs-4 text-reset">₹<%= orig_subtotal.to_i %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Extra Charges Card -->
    <% extra_charges = @booking.booking_extra_charges.order(created_at: :desc) %>
    <% if extra_charges.any? || current_user&.admin? %>
      <div class="card mb-4" style="border-radius:14px;border:1px solid var(--border);box-shadow:var(--shadow-md);overflow:hidden;">
        <div class="card-header border-bottom d-flex align-items-center justify-content-between py-3 px-4">
          <div class="d-flex align-items-center gap-2">
            <div style="width:36px;height:36px;border-radius:9px;background:rgba(249,115,22,0.12);display:flex;align-items:center;justify-content:center;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3 class="mb-0 fw-bold fs-4">On-Site Extra Charges</h3>
          </div>
          <% pending_count = extra_charges.count(&:pending?) %>
          <% if pending_count > 0 %>
            <span class="badge bg-warning-lt fw-semibold px-3 py-2"><%= pending_count %> Pending Review</span>
          <% end %>
        </div>

        <% if extra_charges.none? %>
          <div class="px-4 py-4 text-secondary small">No extra charges added by the worker yet.</div>
        <% else %>
          <div class="px-4 py-3">
            <% extra_charges.each do |charge| %>
              <div class="d-flex align-items-center gap-3 py-3 border-bottom" style="<%= 'opacity:0.5;' if charge.rejected? %>">
                <!-- Type badge -->
                <% icon_bg, icon_color = case charge.charge_type
                                         when "service" then ["rgba(99,102,241,0.12)", "#6366f1"]
                                         when "product" then ["rgba(14,165,233,0.12)", "#0ea5e9"]
                                         else               ["rgba(249,115,22,0.12)", "#f97316"]
                                         end %>
                <div style="width:36px;height:36px;border-radius:9px;background:<%= icon_bg %>;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="<%= icon_color %>" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <% if charge.charge_type == "service" %>
                      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
                    <% elsif charge.charge_type == "product" %>
                      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>
                    <% else %>
                      <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    <% end %>
                  </svg>
                </div>

                <!-- Description & meta -->
                <% charge_disc = @booking.coupon&.apply_to_extra(charge.line_total.to_f, @booking.discount_amount) || 0.0 %>
                <% unit_disc   = @booking.coupon&.apply_to_extra(charge.amount.to_f,      @booking.discount_amount) || 0.0 %>
                <div class="flex-fill">
                  <div class="fw-semibold text-reset" style="font-size:14px;"><%= charge.description %></div>
                  <div class="text-secondary" style="font-size:12px;">
                    <%= charge.charge_type.capitalize %> &bull; Qty <%= charge.quantity %> &bull;
                    <% if unit_disc > 0 %>
                      <span class="text-decoration-line-through">₹<%= charge.amount.to_i %></span>
                      <span class="text-success fw-semibold">₹<%= (charge.amount.to_f - unit_disc).round(2) %></span> each
                    <% else %>
                      ₹<%= charge.amount.to_i %> each
                    <% end %>
                  </div>
                </div>

                <!-- Line total (discounted if coupon active) -->
                <div class="text-end" style="min-width:80px;">
                  <% if charge_disc > 0 %>
                    <div class="text-decoration-line-through text-secondary" style="font-size:11px;">₹<%= charge.line_total.to_i %></div>
                    <div class="fw-bold text-success" style="font-size:15px;">₹<%= (charge.line_total.to_f - charge_disc).round(2) %></div>
                    <span class="badge bg-danger-lt fw-bold" style="font-size:10px;">(₹<%= charge_disc.round(2) %> OFF)</span>
                  <% else %>
                    <div class="fw-bold text-reset" style="font-size:15px;">₹<%= charge.line_total.to_i %></div>
                  <% end %>
                </div>

                <!-- Status / Actions -->
                <div style="min-width:130px;text-align:right;">
                  <% if charge.pending? && current_user&.admin? %>
                    <div class="d-flex gap-1 justify-content-end">
                      <%= button_to approve_admin_booking_extra_charge_path(@booking, charge),
                            method: :patch,
                            class: "btn btn-sm btn-success px-2 py-1",
                            style: "font-size:12px;border-radius:7px;",
                            title: "Approve" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Approve
                      <% end %>
                      <%= button_to reject_admin_booking_extra_charge_path(@booking, charge),
                            method: :patch,
                            class: "btn btn-sm btn-outline-danger px-2 py-1",
                            style: "font-size:12px;border-radius:7px;",
                            title: "Reject" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        Reject
                      <% end %>
                    </div>
                  <% elsif charge.pending? %>
                    <span class="badge bg-warning-lt">Pending</span>
                  <% elsif charge.approved? %>
                    <span class="badge bg-success-lt">Approved</span>
                  <% else %>
                    <span class="badge bg-secondary-lt">Rejected</span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Approved total summary (net after discount) -->
            <% approved_charges = extra_charges.select(&:approved?) %>
            <% if approved_charges.any? %>
              <% gross_extra = approved_charges.sum(&:line_total).to_f %>
              <% disc_extra  = approved_charges.sum { |c| @booking.coupon&.apply_to_extra(c.line_total.to_f, @booking.discount_amount) || 0.0 } %>
              <% net_extra   = (gross_extra - disc_extra).round(2) %>
              <div class="d-flex justify-content-between align-items-center pt-3 pb-1">
                <span class="text-secondary small fw-medium">Approved Extra Charges Total</span>
                <div class="text-end">
                  <% if disc_extra > 0 %>
                    <span class="text-decoration-line-through text-secondary small me-1" style="font-size:11px;">₹<%= gross_extra.to_i %></span>
                  <% end %>
                  <span class="fw-bold text-success fs-4">+₹<%= net_extra %></span>
                </div>
              </div>
              <div class="d-flex justify-content-between align-items-center pb-2">
                <span class="text-secondary small fw-medium">Updated Booking Total</span>
                <span class="fw-bold fs-3 text-reset"><%= @booking.display_amount %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Customer Service Location & GPS Map Card -->
    <% lat = @booking.effective_latitude %>
    <% lng = @booking.effective_longitude %>
    <% has_gps = lat.present? && lng.present? %>

    <style>
      #bc-location-card { animation: bcFadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both; }
      @keyframes bcFadeUp { from { opacity:0;transform:translateY(18px);} to { opacity:1;transform:translateY(0);} }
      .bc-gps-badge { position:relative;display:inline-flex;align-items:center;gap:6px; }
      .bc-gps-dot { width:10px;height:10px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 0 rgba(34,197,94,0.6);animation:bcPulse 1.8s ease-out infinite; }
      @keyframes bcPulse { 0%{box-shadow:0 0 0 0 rgba(34,197,94,0.6);}70%{box-shadow:0 0 0 10px rgba(34,197,94,0);}100%{box-shadow:0 0 0 0 rgba(34,197,94,0);} }
      #booking-map { border-radius:12px;overflow:hidden;height:300px;opacity:0;transition:opacity 0.6s ease; }
      .bc-pulse-ring { width:20px;height:20px;border-radius:50%;background:rgba(239,68,68,0.25);border:2px solid #ef4444;animation:bcRingPulse 1.6s ease-out infinite; }
      @keyframes bcRingPulse { 0%{transform:scale(1);opacity:1;}100%{transform:scale(3.2);opacity:0;} }
      .bc-nav-btn { display:flex;align-items:center;justify-content:center;gap:7px;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;transition:all 0.18s cubic-bezier(0.16,1,0.3,1);border:1.5px solid var(--border-strong);color:var(--text-2);background:var(--surface);flex:1; }
      .bc-nav-btn:hover { background:var(--accent);color:#fff;border-color:var(--accent);transform:translateY(-2px);box-shadow:var(--shadow-md); }
      .bc-nav-btn svg { width:16px;height:16px;flex-shrink:0; }
    </style>

    <div id="bc-location-card" class="card mb-4" style="border-radius:14px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-md);">
      <div class="card-header border-bottom d-flex align-items-center justify-content-between py-3 px-4">
        <div class="d-flex align-items-center gap-2">
          <div style="width:36px;height:36px;border-radius:9px;background:rgba(239,68,68,0.12);display:flex;align-items:center;justify-content:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="mb-0 fw-bold fs-4">Service Location</h3>
        </div>
        <% if has_gps %>
          <span class="bc-gps-badge badge bg-success-lt fw-semibold px-3 py-2"><span class="bc-gps-dot"></span> GPS Verified</span>
        <% else %>
          <span class="badge bg-secondary-lt fw-semibold px-3 py-2">Address Only</span>
        <% end %>
      </div>

      <div class="px-4 pt-3 pb-2">
        <div class="text-secondary small fw-medium mb-1 text-uppercase" style="letter-spacing:.06em;">Full Service Address</div>
        <div class="fw-semibold fs-4 text-reset d-flex align-items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-top:3px;flex-shrink:0"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <%= @booking.address&.full_address.presence || "No street address on record" %>
        </div>
      </div>

      <% if has_gps %>
        <div class="px-4 pb-2">
          <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
          <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
          <div id="booking-map" class="shadow-sm"></div>
          <script>
            (function(){
              var LAT=<%= lat %>,LNG=<%= lng %>;
              function initMap(){
                var el=document.getElementById('booking-map');
                if(!el||typeof L==='undefined')return;
                var map=L.map('booking-map',{scrollWheelZoom:false});
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; <a href="https://openstreetmap.org">OpenStreetMap</a>'}).addTo(map);
                map.setView([LAT,LNG],5);
                setTimeout(function(){map.flyTo([LAT,LNG],15,{animate:true,duration:1.4});},200);
                var icon=L.divIcon({className:'',html:'<div style="position:relative;width:44px;height:44px;"><div class="bc-pulse-ring" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);"></div><div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:14px;height:14px;background:#ef4444;border-radius:50%;border:2px solid #fff;"></div></div>',iconSize:[44,44],iconAnchor:[22,22]});
                var m=L.marker([LAT,LNG],{icon:icon}).addTo(map);
                m.bindPopup('<b>📍 Service Location</b>',{maxWidth:180});
                setTimeout(function(){el.style.opacity='1';},1200);
                setTimeout(function(){m.openPopup();},1700);
              }
              document.readyState==='loading'?document.addEventListener('DOMContentLoaded',initMap):initMap();
            })();
          </script>
        </div>
        <div class="d-flex gap-2 px-4 pb-4 pt-2">
          <a href="https://www.google.com/maps/dir/?api=1&destination=<%= lat %>,<%= lng %>" target="_blank" rel="noopener" class="bc-nav-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg> Navigate (Google Maps)
          </a>
          <a href="https://www.openstreetmap.org/?mlat=<%= lat %>&mlon=<%= lng %>#map=16/<%= lat %>/<%= lng %>" target="_blank" rel="noopener" class="bc-nav-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg> OpenStreetMap
          </a>
        </div>
      <% else %>
        <div class="px-4 pb-4">
          <div class="alert alert-info d-flex align-items-center mb-0" style="border-radius:10px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            GPS coordinates were not captured for this booking.
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-4">
    <!-- Consent & Product Sourcing Card -->
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom">
        <h3 class="card-title fw-bold">Consent & Products</h3>
      </div>
      <div class="card-body">
        <div class="mb-3 pb-2 border-bottom">
          <div class="text-secondary small mb-1">Product Sourcing:</div>
          <% consent = @booking.service_consent %>
          <% if consent&.product_source == "customer" %>
            <span class="badge bg-purple-lt fs-4 px-2 py-1">
              <i class="ti ti-user me-1"></i> Customer's Own Products
            </span>
            <div class="text-secondary small mt-1">Platform kit fee waived (&#8377;0.00)</div>
          <% else %>
            <span class="badge bg-azure-lt fs-4 px-2 py-1">
              <i class="ti ti-package me-1"></i> Platform Sanitized Products Kit
            </span>
            <% kit_fee = @booking.booking_products.sum { |bp| bp.price_snapshot.to_f * bp.quantity } %>
            <% if kit_fee > 0 %>
              <div class="text-secondary small mt-1">Platform Kit Fee: &#8377;<%= '%.2f' % kit_fee %></div>
            <% end %>
          <% end %>
        </div>

        <div>
          <div class="text-secondary small mb-1">Consent Agreement:</div>
          <% if consent&.terms_accepted %>
            <span class="badge bg-success-lt fs-4 px-2 py-1">
              <i class="ti ti-check me-1"></i> Agreed (<%= consent.terms_version || 'v1.0' %>)
            </span>
            <div class="text-secondary small mt-1">
              <%= consent.consented_at&.strftime("%b %d, %Y %I:%M %p") || "At checkout" %>
            </div>
          <% else %>
            <span class="badge bg-secondary-lt fs-4 px-2 py-1">
              <i class="ti ti-clock me-1"></i> Pending Service Signoff
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom">
        <h3 class="card-title fw-bold"><%= current_user&.worker? ? "Specialist Actions" : "Dispatch Actions" %></h3>
      </div>
      <div class="card-body d-flex flex-column gap-2">
        <% if current_user&.worker? && @booking.worker_id.to_s == current_user.id.to_s %>
          <% if @booking.status == "pending" %>
            <%= button_to accept_admin_booking_path(@booking.id), method: :patch, class: "btn btn-success w-100 py-2", data: { turbo_confirm: "Are you sure you want to accept this booking?", confirm_title: "Accept Booking", confirm_btn: "Accept Booking", confirm_theme: "success" } do %>
              <i class="ti ti-check me-1 fs-3"></i> Accept Booking
            <% end %>
            <%= button_to reject_admin_booking_path(@booking.id), method: :patch, class: "btn btn-outline-danger w-100 py-2", data: { turbo_confirm: "Are you sure you want to reject this booking?", confirm_title: "Reject Booking", confirm_btn: "Reject Booking" } do %>
              <i class="ti ti-x me-1 fs-3"></i> Reject Booking
            <% end %>
          <% end %>
        <% end %>

        <% if (current_user&.worker? && @booking.worker_id.to_s == current_user.id.to_s) || current_user&.admin? %>
          <% unless %w[cancelled rejected].include?(@booking.booking_status) %>
            <!-- Service Fulfillment Section -->
            <% if @booking.service_status != "completed" %>
              <div class="p-3 rounded-3 border mb-2" style="background: rgba(16, 185, 129, 0.05); border-color: rgba(16, 185, 129, 0.25) !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="fw-bold text-success"><i class="ti ti-scissors me-1"></i> Service Execution</span>
                  <span class="badge bg-warning-lt">Pending Completion</span>
                </div>
                <p class="small text-muted mb-3">When you have completed the service appointment, mark it completed here to notify the customer and unlock their review.</p>
                <%= form_with url: complete_service_admin_booking_path(@booking), method: :patch, local: true do |f| %>
                  <% if @booking.payment_status != "completed" %>
                    <div class="form-check mb-3">
                      <input class="form-check-input" type="checkbox" name="collect_payment" value="1" id="collectPaymentWithService" checked>
                      <label class="form-check-label small fw-medium" for="collectPaymentWithService">
                        Also mark payment of <%= @booking.display_amount %> collected
                      </label>
                    </div>
                  <% end %>
                  <%= f.button type: :submit, class: "btn btn-success w-100 py-2 fw-semibold", data: { turbo_confirm: "Confirm that this service has been fully completed for customer #{@booking.customer_name}?" } do %>
                    <i class="ti ti-check-double me-1 fs-3"></i> Mark Service as Completed
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <div class="p-2 rounded-3 border mb-2 d-flex align-items-center bg-success-lt text-success">
                <i class="ti ti-circle-check fs-2 me-2"></i>
                <div>
                  <div class="fw-bold">Service Completed</div>
                  <div class="small text-muted">Customer sees this appointment as completed and can submit a review.</div>
                </div>
              </div>
            <% end %>

            <!-- Payment Collection Section -->
            <% if @booking.payment_status != "completed" %>
              <div class="p-3 rounded-3 border mb-2" style="background: rgba(59, 130, 246, 0.05); border-color: rgba(59, 130, 246, 0.25) !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="fw-bold text-primary"><i class="ti ti-cash me-1"></i> Payment Settlement</span>
                  <span class="badge bg-warning-lt">Due: <%= @booking.display_amount %></span>
                </div>
                <p class="small text-muted mb-2">Confirm receipt of payment from the customer:</p>
                <%= form_with url: complete_payment_admin_booking_path(@booking), method: :patch, local: true do |f| %>
                  <div class="mb-3">
                    <div class="input-group">
                      <span class="input-group-text"><i class="ti ti-wallet"></i></span>
                      <select name="payment_method" class="form-select">
                        <option value="cash" selected>Cash on Service</option>
                        <option value="upi">UPI / QR Code</option>
                        <option value="card">Debit / Credit Card</option>
                        <option value="wallet">Digital Wallet</option>
                      </select>
                    </div>
                  </div>
                  <%= f.button type: :submit, class: "btn btn-outline-primary w-100 py-2 fw-semibold", data: { turbo_confirm: "Confirm collection of #{@booking.display_amount} from customer #{@booking.customer_name}?" } do %>
                    <i class="ti ti-check me-1 fs-3"></i> Confirm Payment Received (<%= @booking.display_amount %>)
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <div class="p-2 rounded-3 border mb-2 d-flex align-items-center bg-success-lt text-success">
                <i class="ti ti-receipt-2 fs-2 me-2"></i>
                <div>
                  <div class="fw-bold">Payment Settled (<%= @booking.display_amount %>)</div>
                  <div class="small text-muted">Payment has been marked completed in the platform ledger.</div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
        <div class="py-2 d-flex flex-column gap-2 border-bottom mb-2">
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-secondary small fw-medium">Booking Status:</span>
            <%= booking_status_badge(@booking.booking_status) %>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-secondary small fw-medium">Service Status:</span>
            <%= service_status_badge(@booking.service_status) %>
          </div>
        </div>
        <% if current_user&.admin? %>
          <%= link_to edit_admin_booking_path(@booking[:id]), class: "btn btn-primary w-100" do %>
            <i class="ti ti-user-check me-1 fs-3"></i> Reassign / Dispatch Worker
          <% end %>
        <% end %>
        <button class="btn btn-outline-secondary w-100" onclick="window.print()">
          <i class="ti ti-printer me-1 fs-3"></i> Print Booking Invoice
        </button>
      </div>
    </div>

    <!-- Card 1: Add On-Site Extra Service -->
    <% coupon_info = @booking.coupon %>
    <% coupon_type = coupon_info&.discount_type || "" %>
    <% coupon_val  = coupon_info&.discount_value.to_f %>
    <% coupon_code = coupon_info&.code || "" %>

    <div class="card mb-4" id="bc-add-service-card" style="border-radius:14px;border:1px solid var(--border);box-shadow:var(--shadow-md);overflow:hidden;">
      <div class="card-header border-bottom d-flex align-items-center justify-content-between py-3 px-4" style="background:var(--surface);">
        <div class="d-flex align-items-center gap-2">
          <div style="width:32px;height:32px;border-radius:8px;background:rgba(99,102,241,0.12);display:flex;align-items:center;justify-content:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          </div>
          <h3 class="card-title mb-0 fw-bold fs-4">Add On-Site Service</h3>
        </div>
        <span class="badge bg-indigo-lt fw-semibold">Service</span>
      </div>

      <div class="card-body p-3">
        <%= form_with url: admin_booking_extra_charges_path(@booking), method: :post, local: true, id: "add-service-form" do |f| %>
          <%= hidden_field_tag :charge_type, "service" %>
          <%= hidden_field_tag :service_id, "", id: "selected-service-id" %>

          <!-- Search input -->
          <div class="mb-3">
            <div class="input-icon">
              <span class="input-icon-addon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </span>
              <input type="text" id="service-search-input" class="form-control" placeholder="Search platform services..." autocomplete="off" oninput="window.filterServicesDebounced(this.value)" onkeyup="window.filterServicesDebounced(this.value)">
            </div>
          </div>

          <!-- Services List -->
          <div id="services-list-container" class="border rounded-3 p-2 mb-3 bg-body-tertiary" style="max-height:220px;overflow-y:auto;">
            <% (@available_services || Service.active.ordered).each do |svc| %>
              <% s_eff_price = svc.effective_price.to_f %>
              <% s_unit_disc = coupon_info ? coupon_info.apply_to_extra(s_eff_price) : 0.0 %>
              <% s_net_price = (s_eff_price - s_unit_disc).round(2) %>

              <div class="service-option-item p-2 rounded-2 mb-1 cursor-pointer"
                   style="display:flex;align-items:center;justify-content:space-between;cursor:pointer;transition:all 0.15s ease;border:1px solid transparent;"
                   data-id="<%= svc.id %>"
                   data-name="<%= svc.name %>"
                   data-price="<%= s_eff_price %>"
                   data-duration="<%= svc.duration_minutes %>"
                   data-image="<%= svc.image_url.presence || '' %>"
                   data-disc="<%= s_unit_disc %>"
                   data-net="<%= s_net_price %>"
                   onclick="selectService(this)">
                <div class="d-flex align-items-center gap-2" style="min-width:0;">
                  <% if svc.image_url.present? %>
                    <img src="<%= svc.image_url %>" alt="<%= svc.name %>" style="width:36px;height:36px;border-radius:8px;object-fit:cover;flex-shrink:0;">
                  <% else %>
                    <div style="width:36px;height:36px;border-radius:8px;background:rgba(99,102,241,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#6366f1;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </div>
                  <% end %>
                  <div class="text-truncate">
                    <div class="fw-semibold text-truncate" style="font-size:13px;"><%= svc.name %></div>
                    <div class="text-secondary small" style="font-size:11px;">
                      <i class="ti ti-clock"></i> <%= svc.duration_minutes %> mins
                    </div>
                  </div>
                </div>
                <div class="text-end flex-shrink-0 ms-2">
                  <% if s_unit_disc > 0 %>
                    <div class="text-decoration-line-through text-secondary" style="font-size:10px;">₹<%= s_eff_price.to_i %></div>
                    <div class="fw-bold text-success" style="font-size:13px;">₹<%= s_net_price %></div>
                  <% else %>
                    <div class="fw-bold text-reset" style="font-size:13px;">₹<%= s_eff_price.to_i %></div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Selected service details & quantity -->
          <div id="service-selected-panel" class="d-none border rounded-3 p-3 mb-3" style="background:rgba(99,102,241,0.04);border-color:rgba(99,102,241,0.2) !important;">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="fw-bold text-primary text-truncate" id="selected-service-name" style="font-size:14px;"></div>
              <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="clearSelectedService()">Clear</button>
            </div>
            <div class="d-flex align-items-center justify-content-between">
              <label class="text-secondary small fw-medium mb-0">Quantity:</label>
              <div class="input-group input-group-sm" style="width:110px;">
                <button type="button" class="btn btn-outline-secondary" onclick="adjustSvcQty(-1)">-</button>
                <input type="number" id="service-qty-input" name="quantity" class="form-control text-center px-1" value="1" min="1" max="99" onchange="calcServiceSummary()">
                <button type="button" class="btn btn-outline-secondary" onclick="adjustSvcQty(1)">+</button>
              </div>
            </div>
          </div>

          <!-- Live Price Breakdown -->
          <div id="service-price-summary" class="p-2 mb-3 rounded-2 bg-body-tertiary" style="font-size:12px;">
            <div class="d-flex justify-content-between text-secondary mb-1">
              <span>Gross Price:</span>
              <span id="svc-sum-gross" class="fw-semibold">₹0.00</span>
            </div>
            <% if coupon_info %>
              <div class="d-flex justify-content-between text-danger mb-1">
                <span>Coupon (<%= coupon_code %>):</span>
                <span id="svc-sum-discount" class="fw-semibold">-₹0.00</span>
              </div>
            <% end %>
            <div class="d-flex justify-content-between fw-bold text-reset pt-1 border-top" style="font-size:13px;">
              <span>Net Added Total:</span>
              <span id="svc-sum-net" class="text-success">₹0.00</span>
            </div>
          </div>

          <button type="submit" id="svc-submit-btn" class="btn btn-primary w-100" disabled>
            <i class="ti ti-plus me-1"></i> Add Service to Booking
          </button>
        <% end %>
      </div>
    </div>

    <!-- Card 2: Add Product / Custom Charge -->
    <div class="card mb-4" id="bc-add-product-card" style="border-radius:14px;border:1px solid var(--border);box-shadow:var(--shadow-md);overflow:hidden;">
      <div class="card-header border-bottom d-flex align-items-center justify-content-between py-3 px-4" style="background:var(--surface);">
        <div class="d-flex align-items-center gap-2">
          <div style="width:32px;height:32px;border-radius:8px;background:rgba(14,165,233,0.12);display:flex;align-items:center;justify-content:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
          </div>
          <h3 class="card-title mb-0 fw-bold fs-4">Add Product / Custom</h3>
        </div>
        <!-- Type switch pills -->
        <ul class="nav nav-pills card-header-pills" id="prod-custom-tabs" role="tablist">
          <li class="nav-item">
            <button class="nav-link active py-1 px-2 small fw-semibold" id="tab-product-btn" onclick="switchProdTab('product')">Product</button>
          </li>
          <li class="nav-item">
            <button class="nav-link py-1 px-2 small fw-semibold" id="tab-custom-btn" onclick="switchProdTab('custom')">Custom</button>
          </li>
        </ul>
      </div>

      <div class="card-body p-3">
        <!-- FORM FOR PRODUCT / CUSTOM -->
        <%= form_with url: admin_booking_extra_charges_path(@booking), method: :post, local: true, id: "add-prod-custom-form" do |f| %>
          <%= hidden_field_tag :charge_type, "product", id: "prod-charge-type" %>
          <%= hidden_field_tag :product_id, "", id: "selected-product-id" %>

          <!-- Section A: Product View -->
          <div id="product-tab-content">
            <div class="mb-3">
              <div class="input-icon">
                <span class="input-icon-addon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </span>
                <input type="text" id="product-search-input" class="form-control" placeholder="Search salon products..." autocomplete="off" oninput="window.filterProductsDebounced(this.value)" onkeyup="window.filterProductsDebounced(this.value)">
              </div>
            </div>

            <!-- Products list -->
            <div id="products-list-container" class="border rounded-3 p-2 mb-3 bg-body-tertiary" style="max-height:200px;overflow-y:auto;">
              <% (@available_products || Product.active.ordered).each do |prd| %>
                <% p_price = prd.selling_price.to_f %>
                <% p_disc  = coupon_info ? coupon_info.apply_to_extra(p_price) : 0.0 %>
                <% p_net   = (p_price - p_disc).round(2) %>

                <div class="product-option-item p-2 rounded-2 mb-1 cursor-pointer"
                     style="display:flex;align-items:center;justify-content:space-between;cursor:pointer;transition:all 0.15s ease;border:1px solid transparent;"
                     data-id="<%= prd.id %>"
                     data-name="<%= prd.name %>"
                     data-unit="<%= prd.unit %>"
                     data-price="<%= p_price %>"
                     data-disc="<%= p_disc %>"
                     data-net="<%= p_net %>"
                     onclick="selectProduct(this)">
                  <div class="d-flex align-items-center gap-2" style="min-width:0;">
                    <div style="width:32px;height:32px;border-radius:6px;background:rgba(14,165,233,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#0ea5e9;">
                      <i class="ti ti-package fs-3"></i>
                    </div>
                    <div class="text-truncate">
                      <div class="fw-semibold text-truncate" style="font-size:13px;"><%= prd.name %></div>
                      <div class="text-secondary small" style="font-size:11px;">Unit: <%= prd.unit %></div>
                    </div>
                  </div>
                  <div class="text-end flex-shrink-0 ms-2">
                    <% if p_disc > 0 %>
                      <div class="text-decoration-line-through text-secondary" style="font-size:10px;">₹<%= p_price.to_i %></div>
                      <div class="fw-bold text-success" style="font-size:13px;">₹<%= p_net %></div>
                    <% else %>
                      <div class="fw-bold text-reset" style="font-size:13px;">₹<%= p_price.to_i %></div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- Selected Product panel -->
            <div id="product-selected-panel" class="d-none border rounded-3 p-3 mb-3" style="background:rgba(14,165,233,0.04);border-color:rgba(14,165,233,0.2) !important;">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="fw-bold text-azure text-truncate" id="selected-product-name" style="font-size:14px;"></div>
                <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="clearSelectedProduct()">Clear</button>
              </div>
              <div class="d-flex align-items-center justify-content-between">
                <label class="text-secondary small fw-medium mb-0">Quantity:</label>
                <div class="input-group input-group-sm" style="width:110px;">
                  <button type="button" class="btn btn-outline-secondary" onclick="adjustProdQty(-1)">-</button>
                  <input type="number" id="product-qty-input" name="product_quantity" class="form-control text-center px-1" value="1" min="1" max="99" onchange="calcProductSummary()">
                  <button type="button" class="btn btn-outline-secondary" onclick="adjustProdQty(1)">+</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Section B: Custom Charge View -->
          <div id="custom-tab-content" class="d-none">
            <div class="mb-3">
              <label class="form-label small fw-medium">Description / Reason <span class="text-danger">*</span></label>
              <input type="text" name="description" id="custom-desc-input" class="form-control" placeholder="e.g., Hair Serum / Travel Charge" oninput="calcCustomSummary()">
            </div>
            <div class="row g-2 mb-3">
              <div class="col-7">
                <label class="form-label small fw-medium">Unit Price (₹) <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input type="number" step="0.01" name="amount" id="custom-price-input" class="form-control" placeholder="0.00" min="1" oninput="calcCustomSummary()">
                </div>
              </div>
              <div class="col-5">
                <label class="form-label small fw-medium">Quantity</label>
                <input type="number" name="custom_quantity" id="custom-qty-input" class="form-control text-center" value="1" min="1" max="99" onchange="calcCustomSummary()">
              </div>
            </div>
          </div>

          <!-- Live Price Breakdown for Prod/Custom -->
          <div id="prod-price-summary" class="p-2 mb-3 rounded-2 bg-body-tertiary" style="font-size:12px;">
            <div class="d-flex justify-content-between text-secondary mb-1">
              <span>Gross Price:</span>
              <span id="prod-sum-gross" class="fw-semibold">₹0.00</span>
            </div>
            <% if coupon_info %>
              <div class="d-flex justify-content-between text-danger mb-1">
                <span>Coupon (<%= coupon_code %>):</span>
                <span id="prod-sum-discount" class="fw-semibold">-₹0.00</span>
              </div>
            <% end %>
            <div class="d-flex justify-content-between fw-bold text-reset pt-1 border-top" style="font-size:13px;">
              <span>Net Added Total:</span>
              <span id="prod-sum-net" class="text-success">₹0.00</span>
            </div>
          </div>

          <button type="submit" id="prod-submit-btn" class="btn btn-azure w-100" disabled>
            <i class="ti ti-plus me-1"></i> Add Product to Booking
          </button>
        <% end %>
      </div>
    </div>

    <!-- Script for Debounced Live Search, Filtering, and Calculation -->
    <script>
      (function() {
        var COUPON_TYPE = "<%= coupon_type %>";
        var COUPON_VAL  = <%= coupon_val %>;
        var curSvcPrice = 0;
        var curProdPrice = 0;
        var curTab = 'product';

        function calcDiscount(amount) {
          if (!COUPON_TYPE || amount <= 0) return 0.0;
          if (COUPON_TYPE === 'percentage') {
            return Math.round((amount * COUPON_VAL / 100) * 100) / 100;
          } else {
            return Math.min(COUPON_VAL, amount);
          }
        }

        // 50ms Debounced Service Search
        var _svcTimer = null;
        window.filterServicesDebounced = function(val) {
          clearTimeout(_svcTimer);
          _svcTimer = setTimeout(function() {
            var q = (val || '').toLowerCase().trim();
            var items = document.querySelectorAll('#services-list-container .service-option-item');
            items.forEach(function(el) {
              var name = (el.getAttribute('data-name') || el.innerText || el.textContent || '').toLowerCase();
              var matches = !q || name.indexOf(q) !== -1;
              if (matches) {
                el.style.removeProperty('display');
                el.style.setProperty('display', 'flex', 'important');
              } else {
                el.style.setProperty('display', 'none', 'important');
              }
            });
          }, 50);
        };

        // 50ms Debounced Product Search
        var _prdTimer = null;
        window.filterProductsDebounced = function(val) {
          clearTimeout(_prdTimer);
          _prdTimer = setTimeout(function() {
            var q = (val || '').toLowerCase().trim();
            var items = document.querySelectorAll('#products-list-container .product-option-item');
            items.forEach(function(el) {
              var name = (el.getAttribute('data-name') || el.innerText || el.textContent || '').toLowerCase();
              var matches = !q || name.indexOf(q) !== -1;
              if (matches) {
                el.style.removeProperty('display');
                el.style.setProperty('display', 'flex', 'important');
              } else {
                el.style.setProperty('display', 'none', 'important');
              }
            });
          }, 50);
        };

        window.selectService = function(el) {
          document.querySelectorAll('.service-option-item').forEach(function(i) {
            i.style.borderColor = 'transparent';
            i.style.background = 'transparent';
          });
          el.style.borderColor = 'var(--accent, #6366f1)';
          el.style.background = 'rgba(99,102,241,0.08)';

          var id = el.getAttribute('data-id');
          var name = el.getAttribute('data-name');
          var price = parseFloat(el.getAttribute('data-price')) || 0;

          document.getElementById('selected-service-id').value = id;
          document.getElementById('selected-service-name').innerText = name;
          document.getElementById('service-selected-panel').classList.remove('d-none');
          curSvcPrice = price;

          calcServiceSummary();
          document.getElementById('svc-submit-btn').disabled = false;
        };

        window.clearSelectedService = function() {
          document.getElementById('selected-service-id').value = '';
          document.getElementById('service-selected-panel').classList.add('d-none');
          document.querySelectorAll('.service-option-item').forEach(function(i) {
            i.style.borderColor = 'transparent';
            i.style.background = 'transparent';
          });
          curSvcPrice = 0;
          calcServiceSummary();
          document.getElementById('svc-submit-btn').disabled = true;
        };

        window.adjustSvcQty = function(delta) {
          var input = document.getElementById('service-qty-input');
          var val = Math.max(1, Math.min(99, (parseInt(input.value) || 1) + delta));
          input.value = val;
          calcServiceSummary();
        };

        window.calcServiceSummary = function() {
          var qty = parseInt(document.getElementById('service-qty-input').value) || 1;
          var gross = curSvcPrice * qty;
          var disc = calcDiscount(gross);
          var net = Math.max(0, gross - disc);

          document.getElementById('svc-sum-gross').innerText = '₹' + gross.toFixed(2);
          var discEl = document.getElementById('svc-sum-discount');
          if (discEl) discEl.innerText = '-₹' + disc.toFixed(2);
          document.getElementById('svc-sum-net').innerText = '₹' + net.toFixed(2);
          if (curSvcPrice > 0) {
            document.getElementById('svc-submit-btn').innerHTML = '<i class="ti ti-plus me-1"></i> Add Service (₹' + net.toFixed(2) + ')';
          } else {
            document.getElementById('svc-submit-btn').innerHTML = '<i class="ti ti-plus me-1"></i> Add Service to Booking';
          }
        };

        window.switchProdTab = function(tab) {
          curTab = tab;
          document.getElementById('prod-charge-type').value = tab;
          if (tab === 'product') {
            document.getElementById('tab-product-btn').classList.add('active');
            document.getElementById('tab-custom-btn').classList.remove('active');
            document.getElementById('product-tab-content').classList.remove('d-none');
            document.getElementById('custom-tab-content').classList.add('d-none');
            calcProductSummary();
          } else {
            document.getElementById('tab-custom-btn').classList.add('active');
            document.getElementById('tab-product-btn').classList.remove('active');
            document.getElementById('product-tab-content').classList.add('d-none');
            document.getElementById('custom-tab-content').classList.remove('d-none');
            calcCustomSummary();
          }
        };

        window.selectProduct = function(el) {
          document.querySelectorAll('.product-option-item').forEach(function(i) {
            i.style.borderColor = 'transparent';
            i.style.background = 'transparent';
          });
          el.style.borderColor = 'var(--accent, #0ea5e9)';
          el.style.background = 'rgba(14,165,233,0.08)';

          var id = el.getAttribute('data-id');
          var name = el.getAttribute('data-name');
          var unit = el.getAttribute('data-unit');
          var price = parseFloat(el.getAttribute('data-price')) || 0;

          document.getElementById('selected-product-id').value = id;
          document.getElementById('selected-product-name').innerText = name + ' (' + unit + ')';
          document.getElementById('product-selected-panel').classList.remove('d-none');
          curProdPrice = price;

          calcProductSummary();
          document.getElementById('prod-submit-btn').disabled = false;
        };

        window.clearSelectedProduct = function() {
          document.getElementById('selected-product-id').value = '';
          document.getElementById('product-selected-panel').classList.add('d-none');
          document.querySelectorAll('.product-option-item').forEach(function(i) {
            i.style.borderColor = 'transparent';
            i.style.background = 'transparent';
          });
          curProdPrice = 0;
          calcProductSummary();
          document.getElementById('prod-submit-btn').disabled = true;
        };

        window.adjustProdQty = function(delta) {
          var input = document.getElementById('product-qty-input');
          var val = Math.max(1, Math.min(99, (parseInt(input.value) || 1) + delta));
          input.value = val;
          calcProductSummary();
        };

        window.calcProductSummary = function() {
          if (curTab !== 'product') return;
          var qty = parseInt(document.getElementById('product-qty-input').value) || 1;
          var gross = curProdPrice * qty;
          var disc = calcDiscount(gross);
          var net = Math.max(0, gross - disc);

          document.getElementById('prod-sum-gross').innerText = '₹' + gross.toFixed(2);
          var discEl = document.getElementById('prod-sum-discount');
          if (discEl) discEl.innerText = '-₹' + disc.toFixed(2);
          document.getElementById('prod-sum-net').innerText = '₹' + net.toFixed(2);

          var btn = document.getElementById('prod-submit-btn');
          if (curProdPrice > 0) {
            btn.disabled = false;
            btn.innerHTML = '<i class="ti ti-plus me-1"></i> Add Product (₹' + net.toFixed(2) + ')';
          } else {
            btn.disabled = true;
            btn.innerHTML = '<i class="ti ti-plus me-1"></i> Add Product to Booking';
          }
        };

        var _customTimer = null;
        window.calcCustomSummary = function() {
          clearTimeout(_customTimer);
          _customTimer = setTimeout(function() {
            if (curTab !== 'custom') return;
            var desc = (document.getElementById('custom-desc-input').value || '').trim();
            var unitPrice = parseFloat(document.getElementById('custom-price-input').value) || 0;
            var qty = parseInt(document.getElementById('custom-qty-input').value) || 1;
            var gross = unitPrice * qty;
            var disc = calcDiscount(gross);
            var net = Math.max(0, gross - disc);

            document.getElementById('prod-sum-gross').innerText = '₹' + gross.toFixed(2);
            var discEl = document.getElementById('prod-sum-discount');
            if (discEl) discEl.innerText = '-₹' + disc.toFixed(2);
            document.getElementById('prod-sum-net').innerText = '₹' + net.toFixed(2);

            var btn = document.getElementById('prod-submit-btn');
            if (desc.length > 0 && unitPrice > 0) {
              btn.disabled = false;
              btn.innerHTML = '<i class="ti ti-plus me-1"></i> Add Custom Charge (₹' + net.toFixed(2) + ')';
            } else {
              btn.disabled = true;
              btn.innerHTML = '<i class="ti ti-plus me-1"></i> Add Custom Charge';
            }
          }, 50);
        };

        // Form submission quantity helper
        function setupProdForm() {
          var prodForm = document.getElementById('add-prod-custom-form');
          if (prodForm && !prodForm._bcBound) {
            prodForm._bcBound = true;
            prodForm.addEventListener('submit', function() {
              var oldHidden = prodForm.querySelector('input[data-qty-hidden="true"]');
              if (oldHidden) oldHidden.remove();

              var hiddenQty = document.createElement('input');
              hiddenQty.type = 'hidden';
              hiddenQty.name = 'quantity';
              hiddenQty.setAttribute('data-qty-hidden', 'true');
              if (curTab === 'product') {
                hiddenQty.value = document.getElementById('product-qty-input').value;
              } else {
                hiddenQty.value = document.getElementById('custom-qty-input').value;
              }
              prodForm.appendChild(hiddenQty);
            });
          }
        }

        setupProdForm();
        document.addEventListener('turbo:load', setupProdForm);
        document.addEventListener('turbo:render', setupProdForm);
        document.addEventListener('DOMContentLoaded', setupProdForm);
      })();
    </script>
  </div>
</div>
