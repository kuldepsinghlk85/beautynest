<% content_for :page_title, @service.name %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">
        <%= link_to "Catalog", admin_categories_path, class: "text-secondary text-decoration-none" %> ›
        <%= link_to @service.category.name, admin_category_path(@service.category), class: "text-secondary text-decoration-none" if @service.category %> ›
        <%= link_to @service.subcategory.name, admin_subcategory_path(@service.subcategory), class: "text-secondary text-decoration-none" if @service.subcategory %> ›
        Services
      </div>
      <h2 class="page-title fs-1 fw-bold"><%= @service.name %></h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="btn-list">
        <%= link_to admin_services_path, class: "btn btn-outline-secondary" do %>
          <i class="ti ti-arrow-left me-1 fs-3"></i> Back
        <% end %>
        <% if policy(@service).update? %>
          <%= link_to edit_admin_service_path(@service), class: "btn btn-primary" do %>
            <i class="ti ti-pencil me-1 fs-3"></i> Edit Service
          <% end %>
        <% end %>
        <%= link_to new_admin_service_city_price_path(service_id: @service.id), class: "btn btn-outline-primary" do %>
          <i class="ti ti-currency-rupee me-1 fs-3"></i> Add City Override
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <!-- Service Details -->
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold mb-0">Service Details</h3>
        <div class="d-flex gap-2">
          <%= active_status_badge(@service.status) %>
          <% if @service.featured? %>
            <span class="badge bg-yellow-lt text-yellow"><i class="ti ti-star me-1"></i>Featured</span>
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <div class="row g-3 align-items-start">
          <% svc_img = @service.image_url.presence || (@service.image.attached? && ((@service.image.url rescue nil) || (rails_blob_path(@service.image, only_path: true) rescue nil))) %>
          <% if svc_img.present? %>
            <div class="col-auto">
              <img src="<%= svc_img %>"
                   alt="<%= @service.name %>"
                   class="rounded border shadow-sm"
                   style="width:200px;height:200px;object-fit:cover;" />
            </div>
          <% end %>
          <div class="col">
            <div class="row g-3">
              <div class="col-sm-6">
                <div class="card card-sm bg-surface-secondary border p-3">
                  <div class="text-secondary small">Parent Category</div>
                  <div class="fw-semibold mt-1">
                    <% if @service.category %>
                      <%= link_to @service.category.name, admin_category_path(@service.category), class: "badge bg-azure-lt text-azure text-decoration-none" %>
                    <% else %>
                      <span class="text-secondary">—</span>
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="card card-sm bg-surface-secondary border p-3">
                  <div class="text-secondary small">Subcategory</div>
                  <div class="fw-semibold mt-1">
                    <% if @service.subcategory %>
                      <%= link_to @service.subcategory.name, admin_subcategory_path(@service.subcategory), class: "badge bg-primary-lt text-primary text-decoration-none" %>
                    <% else %>
                      <span class="text-secondary">—</span>
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="col-sm-4">
                <div class="card card-sm bg-surface-secondary border p-3">
                  <div class="text-secondary small">Tag</div>
                  <div class="fw-semibold mt-1">
                    <% tag_badge_class = case @service.tag
                       when "facial"      then "bg-purple-lt text-purple"
                       when "korean-glow" then "bg-pink-lt text-pink"
                       when "mani-padi"   then "bg-teal-lt text-teal"
                       else "bg-secondary-lt text-secondary"
                       end %>
                    <span class="badge <%= tag_badge_class %>"><%= @service.tag_label %></span>
                  </div>
                </div>
              </div>
              <div class="col-sm-4">
                <div class="card card-sm bg-surface-secondary border p-3">
                  <div class="text-secondary small">Slug</div>
                  <div class="fw-semibold font-monospace mt-1"><%= @service.slug %></div>
                </div>
              </div>
              <div class="col-sm-4">
                <div class="card card-sm bg-surface-secondary border p-3">
                  <div class="text-secondary small">Duration</div>
                  <div class="fw-bold fs-3 mt-1"><%= @service.duration_minutes %> min</div>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="card card-sm bg-surface-secondary border p-3">
                  <div class="text-secondary small">Global Base Price</div>
                  <div class="fw-bold fs-3 mt-1"><%= @service.display_base_price %></div>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="card card-sm bg-surface-secondary border p-3">
                  <div class="text-secondary small">Global Effective Price</div>
                  <div class="fw-bold fs-3 text-success mt-1"><%= @service.display_price %></div>
                  <% if @service.on_sale? %>
                    <span class="badge bg-green-lt text-success mt-1">Sale Active</span>
                  <% end %>
                </div>
              </div>
            </div>
            <% if @service.description.present? %>
              <div class="mt-3 text-secondary"><%= @service.description %></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- App Content & Highlights (About, Benefits, Process) -->
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom">
        <h3 class="card-title fw-bold mb-0">App Content & Highlights</h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <div class="text-secondary small fw-semibold">About Service</div>
          <p class="mt-1 mb-0 text-reset"><%= @service.display_about %></p>
        </div>
        <hr class="my-3">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="text-secondary small fw-semibold mb-2">Key Benefits</div>
            <ul class="list-unstyled mb-0">
              <% @service.display_benefits.each do |b| %>
                <li class="d-flex align-items-center mb-1 text-success">
                  <i class="ti ti-check me-2"></i>
                  <span class="text-reset"><%= b %></span>
                </li>
              <% end %>
            </ul>
          </div>
          <div class="col-md-6">
            <div class="text-secondary small fw-semibold mb-2">Step-by-step Process</div>
            <ol class="ps-3 mb-0">
              <% @service.display_process.each do |step| %>
                <li class="mb-1 text-reset"><%= step %></li>
              <% end %>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Customer Reviews -->
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <div>
          <h3 class="card-title fw-bold mb-0">Customer Reviews</h3>
          <div class="text-secondary small">Feedback and ratings received for this service</div>
        </div>
        <div class="d-flex align-items-center">
          <span class="badge bg-yellow-lt text-warning me-2 fs-3">
            ★ <%= @service.average_rating %>
          </span>
          <span class="text-secondary small">(<%= @service.reviews_count %> reviews)</span>
        </div>
      </div>
      <% service_reviews = @service.reviews.includes(:customer).recent %>
      <% if service_reviews.any? %>
        <div class="table-responsive">
          <table class="table table-vcenter card-table table-hover">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Rating</th>
                <th>Comment</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% service_reviews.each do |rev| %>
                <tr>
                  <td class="fw-semibold"><%= rev.customer_name %></td>
                  <td><span class="text-warning fw-bold">★ <%= rev.rating %>/5</span></td>
                  <td class="text-secondary small"><%= rev.comment.presence || "—" %></td>
                  <td class="text-secondary small"><%= rev.display_date %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="card-body text-center py-4 text-secondary">
          No customer reviews received for this service yet.
        </div>
      <% end %>
    </div>

    <!-- City-Wise Pricing Overrides -->
    <div class="card shadow-sm mb-4">
      <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <div>
          <h3 class="card-title fw-bold mb-0">City-Wise Pricing Overrides</h3>
          <div class="text-secondary small">Custom prices that take precedence over the global default in specific cities</div>
        </div>
        <%= link_to new_admin_service_city_price_path(service_id: @service.id), class: "btn btn-sm btn-primary" do %>
          <i class="ti ti-plus me-1"></i> Add City Override
        <% end %>
      </div>

      <% if @active_cities.present? %>
        <div class="table-responsive">
          <table class="table table-vcenter card-table table-hover">
            <thead>
              <tr>
                <th>City</th>
                <th>Base Price</th>
                <th>Discount Price</th>
                <th>Effective Price</th>
                <th>Pricing Rule</th>
                <th class="w-1 text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% @active_cities.each do |city| %>
                <% override = @service.service_city_price_for(city.id) %>
                <tr>
                  <td>
                    <div class="fw-semibold">
                      <%= link_to city.name, admin_city_path(city), class: "text-reset text-decoration-none" %>
                    </div>
                    <div class="text-secondary small"><%= city.state.presence || "—" %></div>
                  </td>
                  <td>
                    <% if override %>
                      <span class="fw-bold text-primary"><%= override.display_base_price %></span>
                    <% else %>
                      <span class="text-secondary"><%= @service.display_base_price %></span>
                    <% end %>
                  </td>
                  <td>
                    <% if override && override.discount_price.present? %>
                      <span class="fw-bold text-success"><%= override.display_price %></span>
                    <% elsif !override && @service.discount_price.present? %>
                      <span class="text-secondary"><%= @service.display_price %></span>
                    <% else %>
                      <span class="text-secondary">—</span>
                    <% end %>
                  </td>
                  <td>
                    <span class="fw-bold fs-3 <%= override ? 'text-primary' : 'text-reset' %>">
                      <%= @service.display_price_for_city(city.id) %>
                    </span>
                  </td>
                  <td>
                    <% if override %>
                      <span class="badge bg-purple-lt text-purple fw-semibold">
                        <i class="ti ti-check me-1"></i> Custom Override
                      </span>
                    <% else %>
                      <span class="badge bg-secondary-lt text-secondary">
                        Global Default
                      </span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <% if override %>
                      <div class="btn-list flex-nowrap justify-content-end">
                        <%= link_to edit_admin_service_city_price_path(override), class: "btn btn-sm btn-icon btn-ghost-primary", title: "Edit Price" do %>
                          <i class="ti ti-pencil fs-3"></i>
                        <% end %>
                        <%= button_to admin_service_city_price_path(override), method: :delete,
                              class: "btn btn-sm btn-icon btn-ghost-danger",
                              title: "Reset to Default",
                              data: { turbo_confirm: "Reset #{city.name} to global default price?" } do %>
                          <i class="ti ti-rotate-2 fs-3"></i>
                        <% end %>
                      </div>
                    <% else %>
                      <%= link_to new_admin_service_city_price_path(service_id: @service.id, city_id: city.id), class: "btn btn-sm btn-outline-primary" do %>
                        <i class="ti ti-plus me-1"></i> Set Override
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="card-body text-center py-4">
          <p class="text-secondary mb-2">No serviceable cities configured yet.</p>
          <%= link_to new_admin_city_path, class: "btn btn-sm btn-outline-primary" do %>
            <i class="ti ti-plus me-1"></i> Add Serviceable City
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header border-bottom">
        <h3 class="card-title fw-bold">Quick Navigation</h3>
      </div>
      <div class="card-body d-flex flex-column gap-2">
        <% if policy(@service).update? %>
          <%= link_to edit_admin_service_path(@service), class: "btn btn-outline-primary w-100 justify-content-start" do %>
            <i class="ti ti-pencil me-2 fs-3"></i> Edit Service
          <% end %>
        <% end %>
        <% if @service.subcategory %>
          <%= link_to admin_subcategory_path(@service.subcategory), class: "btn btn-outline-secondary w-100 justify-content-start" do %>
            <i class="ti ti-subtask me-2 fs-3"></i> View Subcategory (<%= @service.subcategory.name %>)
          <% end %>
        <% end %>
        <% if @service.category %>
          <%= link_to admin_category_path(@service.category), class: "btn btn-outline-secondary w-100 justify-content-start" do %>
            <i class="ti ti-category me-2 fs-3"></i> View Parent Category (<%= @service.category.name %>)
          <% end %>
        <% end %>
        <%= link_to new_admin_service_city_price_path(service_id: @service.id), class: "btn btn-outline-primary w-100 justify-content-start" do %>
          <i class="ti ti-currency-rupee me-2 fs-3"></i> Add City Price Override
        <% end %>
        <% if policy(@service).destroy? %>
          <%= button_to admin_service_path(@service), method: :delete,
                data: { 
                  turbo_confirm: "Are you sure you want to permanently delete service '#{@service.name}'?",
                  confirm_title: "Delete Service",
                  confirm_btn: "Delete Service"
                },
                class: "btn btn-outline-danger w-100 justify-content-start" do %>
            <i class="ti ti-trash me-2 fs-3"></i> Delete Service
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
