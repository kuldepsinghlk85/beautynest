<% content_for :page_title, "New City" %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">Operations › Cities</div>
      <h2 class="page-title fs-1 fw-bold">New Serviceable City</h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <%= link_to admin_cities_path, class: "btn btn-outline-secondary" do %>
        <i class="ti ti-arrow-left me-1 fs-3"></i> Back to Cities
      <% end %>
    </div>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-11 col-xl-10">
    <%= render "form", city: @city %>
  </div>
</div>
