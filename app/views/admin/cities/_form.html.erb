<%= form_with model: [:admin, city], class: "d-flex flex-column gap-4" do |f| %>
  <% if city.errors.any? %>
    <div class="alert alert-danger shadow-sm">
      <h4 class="alert-title fw-bold mb-2">Please fix the following issues:</h4>
      <ul class="mb-0 ps-3">
        <% city.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Section 1: City Details -->
  <div class="card shadow-sm">
    <div class="card-header border-bottom">
      <h3 class="card-title fw-bold mb-0">
        <i class="ti ti-map-pin me-2 text-primary fs-3"></i>
        <%= city.persisted? ? "Edit #{city.name}" : "New Serviceable City" %>
      </h3>
    </div>

    <div class="card-body">
      <div class="row g-4">
        <div class="col-md-4">
          <label class="form-label fw-semibold">City Name <span class="text-danger">*</span></label>
          <%= f.text_field :name, class: "form-control", placeholder: "e.g. Mumbai, Delhi, Bangalore", required: true %>
        </div>

        <div class="col-md-4">
          <label class="form-label fw-semibold">State / Region</label>
          <%= f.text_field :state, class: "form-control", placeholder: "e.g. Maharashtra, Karnataka" %>
        </div>

        <div class="col-md-4">
          <label class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
          <%= f.select :status,
                [["Active", "active"], ["Inactive", "inactive"]],
                {},
                { class: "form-select" } %>
          <div class="form-hint">Inactive cities will not be shown for customer bookings.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 2: City Price Overrides -->
  <% existing_prices = (@service_city_prices || city.service_city_prices).to_a %>
  <div class="card shadow-sm">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h3 class="card-title fw-bold mb-0">
          <i class="ti ti-currency-rupee me-2 text-success fs-3"></i>
          City-Wise Price Overrides
        </h3>
        <div class="text-secondary small mt-1">
          Customize base and promotional discount prices specifically for customers in this city. Services not listed here use their global defaults.
        </div>
      </div>
      <div>
        <button type="button" class="btn btn-sm btn-primary" id="add-override-btn">
          <i class="ti ti-plus me-1"></i> Add Price Override
        </button>
      </div>
    </div>

    <div class="card-body p-0">
      <!-- Empty state when no overrides exist -->
      <div id="no-overrides-msg" class="text-center py-5 <%= 'd-none' if existing_prices.any? %>">
        <div class="avatar avatar-md rounded-circle bg-light-subtle text-secondary mx-auto mb-2">
          <i class="ti ti-currency-rupee fs-3"></i>
        </div>
        <p class="text-secondary fw-medium mb-1">No custom price overrides configured for this city.</p>
        <p class="text-secondary small mb-3">All services currently use their global default prices in <%= city.name.presence || 'this city' %>.</p>
        <button type="button" class="btn btn-sm btn-outline-primary" id="add-override-btn-empty">
          <i class="ti ti-plus me-1"></i> Add First Price Override
        </button>
      </div>

      <!-- Overrides Table -->
      <div class="table-responsive <%= 'd-none' if existing_prices.empty? %>" id="overrides-table-container">
        <table class="table table-vcenter card-table table-hover align-middle mb-0" id="overrides-table">
          <thead class="table-light">
            <tr>
              <th style="min-width: 260px;">Service</th>
              <th style="width: 140px;">Global Default</th>
              <th style="width: 180px;">City Base Price (₹) <span class="text-danger">*</span></th>
              <th style="width: 180px;">City Discount Price (₹)</th>
              <th style="width: 130px;">Status</th>
              <th style="width: 80px;" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody id="overrides-tbody">
            <% existing_prices.each_with_index do |scp, idx| %>
              <%= f.fields_for :service_city_prices, scp do |ff| %>
                <tr class="override-row existing-row" id="existing_row_<%= scp.id %>">
                  <%= ff.hidden_field :id %>
                  <%= ff.hidden_field :service_id %>
                  <%= ff.hidden_field :_destroy, class: "destroy-flag", value: "0" %>

                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div>
                        <div class="fw-semibold text-reset"><%= scp.service.name %></div>
                        <div class="text-secondary small">
                          <span class="badge bg-secondary-subtle text-secondary py-0 px-1 font-monospace">
                            <%= scp.service.subcategory&.category&.name || scp.service.subcategory&.name || 'Service' %>
                          </span>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="text-secondary fw-medium">
                      <%= scp.service.display_price %>
                    </span>
                  </td>
                  <td>
                    <%= ff.number_field :base_price,
                          step: 0.01, min: 0, required: true,
                          class: "form-control form-control-sm base-price-field",
                          placeholder: "e.g. 799" %>
                  </td>
                  <td>
                    <%= ff.number_field :discount_price,
                          step: 0.01, min: 0,
                          class: "form-control form-control-sm discount-price-field",
                          placeholder: "Optional" %>
                  </td>
                  <td>
                    <%= ff.select :status,
                          [["Active", "active"], ["Inactive", "inactive"]],
                          {},
                          class: "form-select form-select-sm" %>
                  </td>
                  <td class="text-end">
                    <div class="btn-list flex-nowrap justify-content-end">
                      <button type="button"
                              class="btn btn-sm btn-icon btn-ghost-danger remove-existing-btn"
                              title="Remove override on save"
                              data-row-id="existing_row_<%= scp.id %>">
                        <i class="ti ti-trash fs-3"></i>
                      </button>
                      <% if scp.persisted? %>
                        <%= link_to admin_service_city_price_path(scp, return_to: edit_admin_city_path(city)),
                              data: {
                                turbo_method: :delete,
                                turbo_confirm: "Permanently delete price override for '#{scp.service.name}' immediately?"
                              },
                              class: "btn btn-sm btn-icon btn-ghost-danger ms-1",
                              title: "Delete immediately" do %>
                          <i class="ti ti-x fs-3 text-danger"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card-footer border-top bg-light-subtle d-flex justify-content-between align-items-center py-3">
      <div class="text-secondary small">
        <span id="active-overrides-counter"><%= existing_prices.size %></span> override(s) configured.
      </div>
      <button type="button" class="btn btn-sm btn-outline-primary" id="add-override-btn-footer">
        <i class="ti ti-plus me-1"></i> Add Another Override
      </button>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="card shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center">
      <%= link_to "Cancel", (city.persisted? ? admin_city_path(city) : admin_cities_path), class: "btn btn-outline-secondary" %>
      <%= f.submit (city.persisted? ? "Update City & Price Overrides" : "Create City & Price Overrides"),
            class: "btn btn-primary px-4 fw-semibold" %>
    </div>
  </div>
<% end %>

<!-- Template for adding new override row dynamically -->
<template id="new-override-template">
  <tr class="override-row new-row">
    <td>
      <select name="city[service_city_prices_attributes][INDEX][service_id]"
              class="form-select form-select-sm service-select"
              required>
        <option value="">— Select Service —</option>
        <% (@available_services || Service.active.ordered.includes(:subcategory)).each do |s| %>
          <option value="<%= s.id %>"
                  data-base-price="<%= s.base_price %>"
                  data-discount-price="<%= s.discount_price %>"
                  data-display-price="<%= s.display_price %>"
                  data-category="<%= s.subcategory&.category&.name || 'Catalog' %>">
            <%= s.name %> (<%= s.subcategory&.category&.name || 'Catalog' %>)
          </option>
        <% end %>
      </select>
    </td>
    <td>
      <span class="text-secondary fw-medium service-default-price">—</span>
    </td>
    <td>
      <input type="number"
             step="0.01" min="0"
             name="city[service_city_prices_attributes][INDEX][base_price]"
             class="form-control form-control-sm base-price-field"
             placeholder="e.g. 799"
             required>
    </td>
    <td>
      <input type="number"
             step="0.01" min="0"
             name="city[service_city_prices_attributes][INDEX][discount_price]"
             class="form-control form-control-sm discount-price-field"
             placeholder="Optional">
    </td>
    <td>
      <select name="city[service_city_prices_attributes][INDEX][status]"
              class="form-select form-select-sm">
        <option value="active" selected>Active</option>
        <option value="inactive">Inactive</option>
      </select>
    </td>
    <td class="text-end">
      <button type="button"
              class="btn btn-sm btn-icon btn-ghost-danger discard-new-btn"
              title="Discard this override">
        <i class="ti ti-trash fs-3"></i>
      </button>
    </td>
  </tr>
</template>

<script>
  (function() {
    function initCityOverrides() {
      const template = document.getElementById("new-override-template");
      const tbody = document.getElementById("overrides-tbody");
      const container = document.getElementById("overrides-table-container");
      const emptyMsg = document.getElementById("no-overrides-msg");
      const counter = document.getElementById("active-overrides-counter");

      if (!template || !tbody) return;

      function updateCounter() {
        const visibleRows = tbody.querySelectorAll("tr.override-row:not(.d-none)");
        if (counter) counter.textContent = visibleRows.length;
        if (visibleRows.length === 0) {
          if (container) container.classList.add("d-none");
          if (emptyMsg) emptyMsg.classList.remove("d-none");
        } else {
          if (container) container.classList.remove("d-none");
          if (emptyMsg) emptyMsg.classList.add("d-none");
        }
      }

      function addRow() {
        const index = new Date().getTime();
        let html = template.innerHTML.replace(/INDEX/g, index);
        const tempTable = document.createElement("tbody");
        tempTable.innerHTML = html;
        const newRow = tempTable.firstElementChild;
        tbody.appendChild(newRow);
        updateCounter();

        // Bind events to new elements
        bindRowEvents(newRow);
        const select = newRow.querySelector(".service-select");
        if (select) select.focus();
      }

      function bindRowEvents(row) {
        const serviceSelect = row.querySelector(".service-select");
        const defaultPriceSpan = row.querySelector(".service-default-price");
        const baseInput = row.querySelector(".base-price-field");
        const discountInput = row.querySelector(".discount-price-field");
        const discardBtn = row.querySelector(".discard-new-btn");

        if (serviceSelect) {
          serviceSelect.addEventListener("change", function() {
            const opt = serviceSelect.options[serviceSelect.selectedIndex];
            if (opt && opt.value) {
              const display = opt.getAttribute("data-display-price") || ("₹" + opt.getAttribute("data-base-price"));
              const base = opt.getAttribute("data-base-price");
              if (defaultPriceSpan) defaultPriceSpan.textContent = display;
              if (baseInput && !baseInput.value) {
                baseInput.value = base;
              }
            } else {
              if (defaultPriceSpan) defaultPriceSpan.textContent = "—";
            }
          });
        }

        if (discardBtn) {
          discardBtn.addEventListener("click", function() {
            row.remove();
            updateCounter();
          });
        }
      }

      // Bind add buttons
      ["add-override-btn", "add-override-btn-empty", "add-override-btn-footer"].forEach(function(id) {
        const btn = document.getElementById(id);
        if (btn) {
          btn.addEventListener("click", function(e) {
            e.preventDefault();
            addRow();
          });
        }
      });

      // Bind existing remove buttons (mark for destruction)
      document.querySelectorAll(".remove-existing-btn").forEach(function(btn) {
        btn.addEventListener("click", function(e) {
          e.preventDefault();
          const row = btn.closest("tr.override-row");
          if (!row) return;
          const destroyFlag = row.querySelector(".destroy-flag");
          if (destroyFlag) {
            destroyFlag.value = "1";
          }
          row.classList.add("d-none");
          updateCounter();
        });
      });

      updateCounter();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCityOverrides);
    } else {
      initCityOverrides();
    }
    document.addEventListener("turbo:load", initCityOverrides);
  })();
</script>
