<% content_for :page_title, "Edit Coupon #{@coupon.code}" %>

<div class="page-header d-print-none mb-4">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle text-secondary">Promotions › Discounts</div>
      <h2 class="page-title fs-1 fw-bold">Edit Coupon: <span class="font-monospace text-primary"><%= @coupon.code %></span></h2>
    </div>
    <div class="col-auto ms-auto d-print-none">
      <div class="btn-list">
        <%= link_to admin_coupon_path(@coupon), class: "btn btn-outline-secondary" do %>
          <i class="ti ti-eye me-1 fs-3"></i> View Details
        <% end %>
        <%= link_to admin_coupons_path, class: "btn btn-outline-secondary" do %>
          <i class="ti ti-arrow-left me-1 fs-3"></i> Back to Coupons
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-9">
    <%= render "form", coupon: @coupon %>
  </div>
</div>
