<%= form_with model: [:admin, coupon], local: true, class: "card shadow-sm" do |f| %>
  <div class="card-header border-bottom">
    <h3 class="card-title fw-bold mb-0">
      <i class="ti ti-tag me-2 text-primary"></i>
      <%= coupon.persisted? ? "Edit Coupon: #{coupon.code}" : "New Promotional Coupon" %>
    </h3>
  </div>

  <% if coupon.errors.any? %>
    <div class="card-body border-bottom bg-danger-lt">
      <div class="alert alert-danger mb-0">
        <h4 class="alert-title fw-bold">Please correct the following errors:</h4>
        <ul class="mb-0 ps-3">
          <% coupon.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="card-body">
    <div class="row g-3 mb-3">
      <!-- Coupon Code -->
      <div class="col-md-6">
        <label class="form-label fw-semibold" for="coupon_code">
          Coupon Code <span class="text-danger">*</span>
        </label>
        <%= f.text_field :code, class: "form-control font-monospace text-uppercase fw-bold fs-3",
              placeholder: "e.g. FESTIVE30", id: "coupon_code", required: true, autocomplete: "off" %>
        <div class="form-hint">Must be unique (auto-capitalized).</div>
      </div>

      <!-- Discount Type -->
      <div class="col-md-6">
        <label class="form-label fw-semibold" for="coupon_discount_type">
          Discount Type <span class="text-danger">*</span>
        </label>
        <%= f.select :discount_type,
              [["Percentage (%)", "percentage"], ["Flat Amount (₹)", "flat"]],
              {}, class: "form-select", id: "coupon_discount_type", required: true %>
        <div class="form-hint">Choose between percent or flat rupee deduction.</div>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <!-- Discount Value -->
      <div class="col-md-6">
        <label class="form-label fw-semibold" for="coupon_discount_value">
          Discount Value <span class="text-danger">*</span>
        </label>
        <%= f.number_field :discount_value, step: "0.01", min: "0.01", class: "form-control fw-bold",
              placeholder: "e.g. 20 (for 20%) or 200 (for ₹200)", id: "coupon_discount_value", required: true %>
        <div class="form-hint">Enter the numeric percentage or rupee amount.</div>
      </div>

      <!-- Max Discount Cap (for percentage) -->
      <div class="col-md-6">
        <label class="form-label fw-semibold" for="coupon_max_discount">
          Maximum Discount Cap (₹)
        </label>
        <%= f.number_field :max_discount, step: "0.01", min: "0", class: "form-control",
              placeholder: "e.g. 300 (leave empty for no limit)", id: "coupon_max_discount" %>
        <div class="form-hint">Ceiling limit for percentage discounts (optional).</div>
      </div>
    </div>

    <!-- Description -->
    <div class="mb-3">
      <label class="form-label fw-semibold" for="coupon_description">Description / Campaign Note</label>
      <%= f.text_area :description, rows: 2, class: "form-control",
            placeholder: "e.g. Special festive celebration discount valid on all spa services.", id: "coupon_description" %>
    </div>

    <div class="row g-3 mb-3">
      <!-- Min Order Amount -->
      <div class="col-md-6">
        <label class="form-label fw-semibold" for="coupon_min_order_amount">
          Minimum Order Spend (₹)
        </label>
        <%= f.number_field :min_order_amount, step: "0.01", min: "0", class: "form-control",
              placeholder: "0 (no minimum required)", id: "coupon_min_order_amount" %>
        <div class="form-hint">Minimum cart subtotal before coupon applies.</div>
      </div>

      <!-- Usage Limit -->
      <div class="col-md-6">
        <label class="form-label fw-semibold" for="coupon_usage_limit">
          Total Redemptions Limit
        </label>
        <%= f.number_field :usage_limit, min: "1", class: "form-control",
              placeholder: "Leave blank for unlimited", id: "coupon_usage_limit" %>
        <div class="form-hint">Max number of times this coupon can be redeemed across the platform.</div>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <!-- Valid From -->
      <div class="col-md-4">
        <label class="form-label fw-semibold" for="coupon_valid_from">Valid From</label>
        <%= f.datetime_local_field :valid_from,
              value: coupon.valid_from&.strftime("%Y-%m-%dT%H:%M"),
              class: "form-control", id: "coupon_valid_from" %>
        <div class="form-hint">Starts immediately if left blank.</div>
      </div>

      <!-- Valid Until -->
      <div class="col-md-4">
        <label class="form-label fw-semibold" for="coupon_valid_until">Valid Until</label>
        <%= f.datetime_local_field :valid_until,
              value: coupon.valid_until&.strftime("%Y-%m-%dT%H:%M"),
              class: "form-control", id: "coupon_valid_until" %>
        <div class="form-hint">Never expires if left blank.</div>
      </div>

      <!-- Status -->
      <div class="col-md-4">
        <label class="form-label fw-semibold" for="coupon_status">Status</label>
        <%= f.select :status,
              [["Active & Redeemable", "active"], ["Inactive / Draft", "inactive"], ["Expired", "expired"]],
              {}, class: "form-select", id: "coupon_status" %>
        <div class="form-hint">Only active coupons can be applied at checkout.</div>
      </div>
    </div>
  </div>

  <div class="card-footer border-top d-flex justify-content-between align-items-center bg-transparent py-3">
    <%= link_to "Cancel", admin_coupons_path, class: "btn btn-outline-secondary" %>
    <%= f.submit coupon.persisted? ? "Save Coupon Changes" : "Create Coupon", class: "btn btn-primary px-4" %>
  </div>
<% end %>
