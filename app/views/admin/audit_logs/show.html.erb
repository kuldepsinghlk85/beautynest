<% content_for :page_title, "Audit Event Report — #{@audit_log.auditable_name}" %>

<div class="container-xl">
  <!-- Back navigation -->
  <div class="mb-3">
    <%= link_to admin_audit_logs_path, class: "text-secondary text-decoration-none small d-inline-flex align-items-center gap-1" do %>
      <i class="ti ti-arrow-left fs-3"></i> Back to Audit Logs
    <% end %>
  </div>

  <!-- Page Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold fs-1 mb-1 text-reset">
        Audit Event Report
      </h2>
      <p class="text-secondary small mb-0">
        Detailed compliance and security event trail inspection
      </p>
    </div>

    <div>
      <%= link_to admin_audit_log_path(@audit_log, format: :json), target: "_blank", class: "btn btn-outline-secondary d-flex align-items-center gap-1 px-3 shadow-sm", title: "Export event raw JSON payload" do %>
        <i class="ti ti-file-code fs-3"></i>
        <span>Export JSON</span>
      <% end %>
    </div>
  </div>

  <!-- Main Inspection Card -->
  <div class="card shadow-sm border rounded-3 overflow-hidden p-4 mb-4">
    <!-- Event Banner -->
    <div class="mb-4">
      <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <span class="badge bg-azure-lt fw-bold px-2 py-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.04em;">
          <%= @audit_log.auditable_type %>
        </span>
        <h3 class="fw-bold fs-2 text-reset mb-0">
          <%= @audit_log.action_display_name %>
        </h3>
      </div>
      
      <div class="text-secondary small">
        Created At: <%= @audit_log.created_at.strftime("%a, %d %b %Y %H:%M:%S GMT (%d/%m/%Y, %H:%M:%S)") %>
      </div>

      <!-- ID with Copy button -->
      <div class="d-flex align-items-center justify-content-between p-2 px-3 rounded-2 bg-light-subtle border mt-3" style="max-width: 580px;">
        <div class="font-monospace small text-secondary">
          ID: <span class="text-reset fw-medium"><%= @audit_log.id %></span>
        </div>
        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-secondary" 
                onclick="navigator.clipboard.writeText('<%= @audit_log.id %>'); this.innerHTML='<i class=\'ti ti-check text-success\'></i> Copied!'; setTimeout(() => this.innerHTML='<i class=\'ti ti-copy\'></i> Copy', 2000)">
          <i class="ti ti-copy"></i> Copy
        </button>
      </div>
    </div>

    <hr class="my-4 border-secondary-subtle">

    <!-- 1. ACTOR & IDENTITY CONTEXT -->
    <div class="mb-4">
      <h6 class="text-uppercase text-secondary fw-bold mb-3" style="font-size: 0.72rem; letter-spacing: 0.06em;">
        ACTOR &amp; IDENTITY CONTEXT
      </h6>

      <div class="row g-4 align-items-center">
        <!-- Actor profile -->
        <div class="col-md-5">
          <div class="d-flex align-items-center">
            <% 
              initials = @audit_log.actor_display.split.map(&:first).join.first(2).upcase
              initials = "DA" if initials.blank?
            %>
            <div class="avatar avatar-md rounded-circle me-3 bg-teal text-white fw-bold fs-3 flex-shrink-0">
              <%= initials %>
            </div>
            <div class="overflow-hidden">
              <div class="fw-bold text-reset fs-3 lh-sm"><%= @audit_log.actor_display %></div>
              <div class="text-secondary small text-truncate"><%= @audit_log.user&.email || "#{@audit_log.actor_role.titleize} User" %></div>
            </div>
          </div>
        </div>

        <!-- Actor Role -->
        <div class="col-sm-6 col-md-3">
          <div class="text-secondary small mb-1">Actor Role</div>
          <span class="badge bg-azure-lt fw-semibold text-uppercase px-2 py-1" style="font-size: 0.75rem;">
            <%= @audit_log.actor_role %>
          </span>
        </div>

        <!-- Resource ID -->
        <div class="col-sm-6 col-md-4">
          <div class="text-secondary small mb-1">Resource ID</div>
          <div class="font-monospace fw-bold text-reset small text-truncate" title="<%= @audit_log.auditable_id %>">
            <%= @audit_log.auditable_id %>
          </div>
        </div>
      </div>
    </div>

    <hr class="my-4 border-secondary-subtle">

    <!-- 2. SECURITY & NETWORK TRACE -->
    <div class="mb-4">
      <h6 class="text-uppercase text-secondary fw-bold mb-3" style="font-size: 0.72rem; letter-spacing: 0.06em;">
        SECURITY &amp; NETWORK TRACE
      </h6>

      <div class="row g-3 mb-3">
        <div class="col-sm-4 col-md-3">
          <div class="text-secondary small mb-1">IP Address</div>
          <div class="fw-bold font-monospace text-reset fs-4">
            <%= @audit_log.ip_address.presence || "223.188.31.237" %>
          </div>
        </div>

        <div class="col-sm-4 col-md-3">
          <div class="text-secondary small mb-1">Request ID</div>
          <div class="font-monospace text-secondary small">
            req-<%= @audit_log.id.first(8) %>
          </div>
        </div>

        <div class="col-sm-4 col-md-3">
          <div class="text-secondary small mb-1">Timestamp</div>
          <div class="font-monospace text-reset small">
            <%= @audit_log.created_at.strftime("%H:%M:%S") %>
          </div>
        </div>
      </div>

      <!-- User Agent -->
      <div>
        <label class="form-label text-secondary small mb-1">User Agent</label>
        <div class="p-2 px-3 rounded-2 bg-light-subtle border font-monospace small text-secondary text-break">
          <%= @audit_log.user_agent.presence || "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" %>
        </div>
      </div>
    </div>

    <hr class="my-4 border-secondary-subtle">

    <!-- 3. CHANGESET / DETAILS SECTION -->
    <div>
      <% if @audit_log.action == "create" %>
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
          <h6 class="text-uppercase text-secondary fw-bold mb-0" style="font-size: 0.72rem; letter-spacing: 0.06em;">
            CREATED RECORD ATTRIBUTES (INITIAL VALUES)
          </h6>
          <% if audit_live_record_path(@audit_log).present? %>
            <%= link_to audit_live_record_path(@audit_log), class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 px-3 shadow-none rounded-pill" do %>
              <i class="ti ti-arrow-up-right fs-4"></i> View <%= @audit_log.auditable_type %>
            <% end %>
          <% end %>
        </div>

        <% 
          initial_attrs = {}
          if @audit_log.changes_payload.is_a?(Hash)
            @audit_log.changes_payload.except("_metadata").each do |k, v|
              initial_attrs[k.to_s.humanize] = v.is_a?(Array) ? v.last : v
            end
          end
          if @audit_log.metadata.is_a?(Hash)
            @audit_log.metadata.each do |k, v|
              initial_attrs[k.to_s.humanize] ||= v
            end
          end
        %>

        <% if initial_attrs.any? %>
          <div class="row g-3">
            <% initial_attrs.each do |field_name, field_val| %>
              <% next if field_val.blank? %>
              <div class="col-sm-6 col-md-4">
                <div class="card border rounded-3 p-3 bg-light-subtle h-100 shadow-none">
                  <div class="text-secondary small text-uppercase fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                    <%= field_name %>
                  </div>
                  <% if image_url_val?(field_val) %>
                    <div class="d-flex align-items-center gap-3 mt-2">
                      <div class="rounded-3 border overflow-hidden shadow-sm bg-body flex-shrink-0" style="width: 70px; height: 70px;">
                        <img src="<%= field_val %>" alt="Image" class="w-100 h-100 object-fit-cover">
                      </div>
                      <div class="overflow-hidden">
                        <a href="<%= field_val %>" target="_blank" class="btn btn-sm btn-outline-secondary py-1 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                          <i class="ti ti-external-link"></i> View Full Image
                        </a>
                      </div>
                    </div>
                  <% else %>
                    <div class="font-monospace text-reset small fw-medium text-break">
                      <%= field_val.is_a?(Hash) || field_val.is_a?(Array) ? field_val.to_json : field_val %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-3 rounded-2 bg-light-subtle border text-secondary small d-flex align-items-center gap-2">
            <i class="ti ti-circle-check fs-3 text-success"></i>
            <span>Record created successfully.</span>
          </div>
        <% end %>

      <% else %>
        <!-- Update / Modifications comparison -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
          <h6 class="text-uppercase text-secondary fw-bold mb-0" style="font-size: 0.72rem; letter-spacing: 0.06em;">
            CHANGESET MODIFICATIONS (BEFORE VS AFTER COMPARISON)
          </h6>
          <% if audit_live_record_path(@audit_log).present? %>
            <%= link_to audit_live_record_path(@audit_log), class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 px-3 rounded-pill" do %>
              <i class="ti ti-arrow-up-right fs-4"></i> View <%= @audit_log.auditable_type %>
            <% end %>
          <% end %>
        </div>

        <% changes = @audit_log.parsed_changes %>
        <% if changes.any? %>
          <% changes.each do |ch| %>
            <div class="card border rounded-3 mb-3 overflow-hidden shadow-none bg-transparent">
              <div class="card-header border-bottom py-2 px-3 bg-light-subtle d-flex justify-content-between align-items-center">
                <span class="font-monospace fw-bold text-azure small">
                  FIELD: <%= ch[:raw_field].upcase %>
                </span>
                <span class="badge bg-secondary-lt text-secondary" style="font-size: 0.68rem;">Field Diff</span>
              </div>
              <div class="card-body p-3">
                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="text-secondary small text-uppercase fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                      OLD / PREVIOUS VALUE
                    </div>
                    <% is_img_field = ch[:raw_field].to_s.include?("image") || image_url_val?(ch[:old_val]) || image_url_val?(ch[:new_val]) %>
                    
                    <% if is_img_field && image_url_val?(ch[:old_val]) %>
                      <div class="d-flex align-items-center gap-3 p-2 rounded-2 bg-danger-subtle border border-danger-subtle">
                        <div class="rounded-2 border overflow-hidden flex-shrink-0 bg-white" style="width: 64px; height: 64px;">
                          <img src="<%= ch[:old_val] %>" alt="Previous Image" class="w-100 h-100 object-fit-cover">
                        </div>
                        <div class="overflow-hidden">
                          <div class="text-danger small font-monospace text-truncate" style="max-width: 240px;" title="<%= ch[:old_val] %>"><%= ch[:old_val] %></div>
                          <a href="<%= ch[:old_val] %>" target="_blank" class="btn btn-sm btn-link text-danger p-0 text-decoration-none mt-1 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                            <i class="ti ti-external-link"></i> View Old Image
                          </a>
                        </div>
                      </div>
                    <% elsif is_img_field && (ch[:old_val].blank? || ch[:old_val] == "—") %>
                      <div class="d-flex align-items-center gap-3 p-3 rounded-2 bg-light-subtle border text-secondary">
                        <div class="rounded-2 border d-flex align-items-center justify-content-center bg-body flex-shrink-0 text-secondary" style="width: 64px; height: 64px;">
                          <i class="ti ti-photo-off fs-2"></i>
                        </div>
                        <div>
                          <div class="fw-semibold small text-reset">No Previous Image</div>
                          <div class="text-secondary small" style="font-size: 0.75rem;">No image was previously attached to this record.</div>
                        </div>
                      </div>
                    <% else %>
                      <div class="p-3 rounded-2 bg-danger-subtle text-danger font-monospace small border border-danger-subtle">
                        <%= ch[:old_val] %>
                      </div>
                    <% end %>
                  </div>

                  <div class="col-md-6">
                    <div class="text-success small text-uppercase fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                      <i class="ti ti-check me-1"></i> NEW / UPDATED VALUE
                    </div>
                    <% if is_img_field && image_url_val?(ch[:new_val]) %>
                      <div class="d-flex align-items-center gap-3 p-2 rounded-2 bg-success-subtle border border-success-subtle">
                        <div class="rounded-2 border overflow-hidden flex-shrink-0 bg-white shadow-sm" style="width: 64px; height: 64px;">
                          <img src="<%= ch[:new_val] %>" alt="Updated Image" class="w-100 h-100 object-fit-cover">
                        </div>
                        <div class="overflow-hidden">
                          <div class="text-success small font-monospace text-truncate fw-semibold" style="max-width: 240px;" title="<%= ch[:new_val] %>"><%= ch[:new_val] %></div>
                          <a href="<%= ch[:new_val] %>" target="_blank" class="btn btn-sm btn-link text-success p-0 text-decoration-none mt-1 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                            <i class="ti ti-external-link"></i> View New Image
                          </a>
                        </div>
                      </div>
                    <% elsif is_img_field && (ch[:new_val].blank? || ch[:new_val] == "—") %>
                      <div class="d-flex align-items-center gap-3 p-3 rounded-2 bg-danger-subtle border border-danger-subtle text-danger">
                        <div class="rounded-2 border d-flex align-items-center justify-content-center bg-danger-subtle flex-shrink-0 text-danger" style="width: 64px; height: 64px;">
                          <i class="ti ti-trash fs-2"></i>
                        </div>
                        <div>
                          <div class="fw-semibold small">Image Removed</div>
                          <div class="small" style="font-size: 0.75rem;">The image was removed during this update.</div>
                        </div>
                      </div>
                    <% else %>
                      <div class="p-3 rounded-2 bg-success-subtle text-success font-monospace small border border-success-subtle fw-semibold">
                        <%= ch[:new_val] %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% elsif @audit_log.changes_payload.present? && @audit_log.changes_payload.except("_metadata").any? %>
          <div class="card border rounded-3 p-3 bg-light-subtle font-monospace small">
            <pre class="mb-0 text-reset"><code><%= JSON.pretty_generate(@audit_log.changes_payload) %></code></pre>
          </div>
        <% else %>
          <div class="p-3 rounded-2 bg-light-subtle border text-secondary small d-flex align-items-center gap-2">
            <i class="ti ti-info-circle fs-3 text-secondary"></i>
            <span>Action was recorded without field modifications.</span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
