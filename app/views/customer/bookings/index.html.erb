<script>
  var currentSelectedRating = 5;
  var ratingMeta = {
    5: { text: "5.0 / 5.0 • Outstanding Experience!", stars: "★★★★★", cssClass: "rm-pill-5" },
    4: { text: "4.0 / 5.0 • Very Good Service", stars: "★★★★☆", cssClass: "rm-pill-4" },
    3: { text: "3.0 / 5.0 • Satisfactory / Met Expectations", stars: "★★★☆☆", cssClass: "rm-pill-3" },
    2: { text: "2.0 / 5.0 • Needs Improvement", stars: "★★☆☆☆", cssClass: "rm-pill-2" },
    1: { text: "1.0 / 5.0 • Unsatisfactory Experience", stars: "★☆☆☆☆", cssClass: "rm-pill-1" }
  };

  function updateStarsUI(rating) {
    var btns = document.querySelectorAll('#rm-stars-row .bc-rm-star-btn');
    btns.forEach(function(btn) {
      var r = parseInt(btn.getAttribute('data-rating'), 10);
      if (r <= rating) {
        btn.classList.add('filled');
      } else {
        btn.classList.remove('filled');
      }
    });

    var feedback = document.getElementById('rm-rating-feedback');
    if (feedback && ratingMeta[rating]) {
      feedback.className = 'bc-rm-rating-pill ' + ratingMeta[rating].cssClass;
      feedback.innerHTML = '<span class="pill-stars">' + ratingMeta[rating].stars + '</span><span class="pill-text">' + ratingMeta[rating].text + '</span>';
    }
  }

  function setReviewRating(rating) {
    currentSelectedRating = rating;
    var input = document.getElementById('review-rating-input');
    if (input) input.value = rating;
    updateStarsUI(rating);
  }

  function previewReviewRating(rating) {
    updateStarsUI(rating);
  }

  function resetReviewRatingPreview() {
    updateStarsUI(currentSelectedRating);
  }

  function toggleReviewTag(btn, tagText) {
    var ta = document.getElementById('review-comment-input');
    if (!ta) return;
    btn.classList.toggle('active');
    var currentText = ta.value.trim();
    if (btn.classList.contains('active')) {
      if (currentText.length > 0 && !currentText.endsWith('.') && !currentText.endsWith(',')) {
        ta.value = currentText + '. ' + tagText;
      } else if (currentText.length > 0) {
        ta.value = currentText + ' ' + tagText;
      } else {
        ta.value = tagText;
      }
    } else {
      ta.value = currentText.replace(tagText, '').replace(/\.\s*\./g, '.').replace(/^\s*\.\s*/, '').trim();
    }
  }

  function openCancelModal(bookingId, bookingNum) {
    document.getElementById('cancel-booking-num').textContent = '#' + bookingNum;
    var form = document.getElementById('cancel-booking-form');
    form.action = '/my-bookings/' + bookingId + '/cancel';
    var modal = document.getElementById('bc-cancel-modal');
    modal.classList.remove('d-none');
    modal.classList.add('open');
    modal.style.display = 'flex';
  }

  function closeCancelModal() {
    var modal = document.getElementById('bc-cancel-modal');
    modal.classList.add('d-none');
    modal.classList.remove('open');
    modal.style.display = 'none';
  }

  function openReviewModal(bookingId, bookingNum, serviceName) {
    document.getElementById('review-service-name').textContent = serviceName || 'Beauty Service';
    var form = document.getElementById('review-booking-form');
    form.action = '/my-bookings/' + bookingId + '/review';

    setReviewRating(5);
    var ta = document.getElementById('review-comment-input');
    if (ta) ta.value = '';
    document.querySelectorAll('.bc-rm-chip').forEach(function(c) { c.classList.remove('active'); });

    var modal = document.getElementById('bc-review-modal');
    modal.classList.remove('d-none');
    modal.classList.add('open');
    modal.style.display = 'flex';
  }

  function closeReviewModal() {
    var modal = document.getElementById('bc-review-modal');
    modal.classList.add('d-none');
    modal.classList.remove('open');
    modal.style.display = 'none';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeCancelModal();
      closeReviewModal();
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    closeCancelModal();
    closeReviewModal();
  });
  document.addEventListener('turbo:load', function() {
    closeCancelModal();
    closeReviewModal();
  });
</script>
