<div class="card-body p-4 p-md-5">
  <div class="text-center mb-4">
    <div class="avatar avatar-lg bg-primary-lt rounded-circle mx-auto mb-3">
      <i class="ti ti-key fs-1 text-primary"></i>
    </div>
    <h2 class="h2 text-center mb-1 fw-bold">Forgot Password?</h2>
    <p class="text-secondary small">Enter your email and we'll send you a link to reset your password</p>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible v6-alert-box mb-4" role="alert">
      <div class="d-flex">
        <div><i class="ti ti-check fs-2 me-2"></i></div>
        <div><%= flash[:notice] %></div>
      </div>
      <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-danger alert-dismissible v6-alert-box mb-4" role="alert">
      <div class="d-flex">
        <div><i class="ti ti-alert-circle fs-2 me-2"></i></div>
        <div><%= flash[:alert] %></div>
      </div>
      <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
    </div>
  <% end %>

  <%= form_with url: forgot_password_path, method: :post, class: "space-y" do |f| %>
    <div class="mb-4">
      <label class="form-label" for="email">
        Registered Email Address <span class="text-danger">*</span>
      </label>
      <div class="input-icon">
        <span class="input-icon-addon">
          <i class="ti ti-mail text-secondary fs-3"></i>
        </span>
        <input type="email" name="email" id="email" class="form-control form-control-lg"
               placeholder="name@example.com" autocomplete="email" required autofocus>
      </div>
    </div>

    <div class="form-footer mt-4">
      <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
        <i class="ti ti-send me-1 fs-3"></i> Send Reset Link
      </button>
    </div>
  <% end %>

  <div class="text-center text-secondary small mt-4 pt-3 border-top">
    Remember your password? <%= link_to "Back to Sign In", login_path, class: "link-primary fw-medium" %>
  </div>
</div>
