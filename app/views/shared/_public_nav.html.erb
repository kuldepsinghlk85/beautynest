<style>
  .bc-master-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    width: 100%;
  }
  .bc-top-bar {
    background: #111827;
    color: #f9fafb;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    padding: 7px 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .bc-top-bar-left, .bc-top-bar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bc-top-pill {
    background: linear-gradient(135deg, #db2777, #be185d);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 50px;
    letter-spacing: 0.04em;
  }
  .bc-nav {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    transition: box-shadow .2s ease;
  }
  .bc-city-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 50px;
    background: rgba(219, 39, 119, 0.06);
    border: 1px solid rgba(219, 39, 119, 0.18);
    font-size: 0.78rem;
    font-weight: 600;
    color: #db2777;
  }
  .bc-lang-toggle {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    border: 1.5px solid rgba(219, 39, 119, 0.25);
    border-radius: 50px;
    padding: 2px 4px;
    font-size: 0.76rem;
    font-weight: 700;
    gap: 2px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  .bc-lang-opt {
    color: #4b5563;
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 50px;
    transition: all 0.16s ease;
  }
  .bc-lang-opt.active {
    background: linear-gradient(135deg, #db2777, #be185d);
    color: #ffffff !important;
    box-shadow: 0 2px 6px rgba(219, 39, 119, 0.3);
  }
  .bc-lang-opt:hover:not(.active) {
    color: #db2777;
    background: rgba(219, 39, 119, 0.05);
  }
  .bc-lang-divider {
    color: rgba(0, 0, 0, 0.2);
    font-size: 0.7rem;
  }
  @media (max-width: 820px) {
    .bc-top-bar { display: none; }
    .bc-city-pill { display: none; }
  }
</style>

<header class="bc-master-header" id="bc-master-header">
  <!-- Top Announcement Bar -->
  <div class="bc-top-bar">
    <div class="bc-top-bar-left">
      <span class="bc-top-pill"><%= t("announcement.special_offer") %></span>
      <span><%= t("announcement.banner_text") %> <strong style="color: #f472b6;">GLOW20</strong></span>
    </div>
    <div class="bc-top-bar-right">
      <span><i class="ti ti-shield-check" style="color: #22c55e;"></i> <%= t("announcement.doorstep_hygiene") %></span>
      <span><i class="ti ti-clock" style="color: #f59e0b;"></i> <%= t("announcement.days_active") %></span>
      <%= link_to "/categories", style: "color: #f472b6; text-decoration: none; font-weight: 600;" do %>
        <%= t("announcement.book_service") %>
      <% end %>
    </div>
  </div>

  <nav class="bc-nav" id="bc-nav">
    <a href="/" class="bc-nav-brand">
      <span class="logo-icon"><i class="ti ti-sparkles"></i></span>
      <span class="brand-text"><%= brand_logo_text %></span>
    </a>

    <div class="bc-nav-links">
      <a href="/"             class="<%= 'bc-nav-active' if active == 'home' %>"><%= t("nav.home") %></a>
      <a href="/categories"   class="<%= 'bc-nav-active' if active == 'categories' %>"><%= t("nav.services") %></a>
      <a href="/offers"       class="bc-nav-hot-link <%= 'bc-nav-active' if active == 'offers' %>">
        <%= t("nav.offers") %> <span class="bc-hot-badge"><%= t("nav.hot_badge") %></span>
      </a>
      <a href="/about"        class="<%= 'bc-nav-active' if active == 'about' %>"><%= t("nav.about") %></a>
      <a href="/contact"      class="<%= 'bc-nav-active' if active == 'contact' %>"><%= t("nav.contact") %></a>
    </div>

    <div class="bc-nav-cta">
      <!-- Language Selector Toggle -->
      <div class="bc-lang-toggle" role="group" aria-label="Language Selector">
        <%= link_to switch_locale_path(locale: "en"), class: "bc-lang-opt #{'active' if english?}", title: "Switch to English" do %>
          EN
        <% end %>
        <span class="bc-lang-divider">/</span>
        <%= link_to switch_locale_path(locale: "hi"), class: "bc-lang-opt #{'active' if hindi?}", title: "हिन्दी में बदलें" do %>
          हिन्दी
        <% end %>
      </div>

      <!-- City location pill -->
      <div class="bc-city-pill">
        <i class="ti ti-map-pin"></i>
        <span><%= t("nav.varanasi") %></span>
      </div>

      <%= link_to cart_path, class: "bc-nav-cart-btn #{'active' if active == 'cart'}", id: "bn-nav-cart-btn", title: t("nav.cart") do %>
        <i class="ti ti-shopping-bag"></i>
        <span class="bc-cart-badge" id="bn-nav-cart-badge"><%= current_cart.item_count %></span>
      <% end %>

    <% if customer_logged_in? %>
      <!-- Customer Profile Dropdown beside Cart -->
      <div class="bc-nav-profile-wrap" id="bc-nav-profile-wrap">
        <button type="button" class="bc-profile-btn" id="bc-profile-dropdown-btn" aria-expanded="false" aria-haspopup="true">
          <span class="bc-profile-avatar-wrap">
            <% if current_customer.avatar_url.present? %>
              <%= image_tag current_customer.avatar_url, alt: current_customer.name, class: "bc-profile-avatar-img", onerror: "this.style.display='none';this.nextElementSibling.style.display='flex';" %>
              <span class="bc-profile-avatar-fallback" style="display:none;"><%= current_customer.initials %></span>
            <% else %>
              <span class="bc-profile-avatar-fallback"><%= current_customer.initials %></span>
            <% end %>
          </span>
          <span class="bc-profile-name d-none d-sm-inline"><%= current_customer.name.split.first %></span>
          <i class="ti ti-chevron-down bc-profile-chevron"></i>
        </button>

        <div class="bc-profile-dropdown" id="bc-profile-dropdown-menu" role="menu">
          <div class="bc-pdrop-header">
            <div class="bc-pdrop-name"><%= current_customer.name %></div>
            <div class="bc-pdrop-meta"><%= current_customer.phone.presence || current_customer.email %></div>
            <span class="bc-pdrop-badge">
              <i class="ti ti-shield-check"></i> Verified Customer
            </span>
          </div>

          <div class="bc-pdrop-items">
            <% if admin_logged_in? %>
              <div class="px-3 py-2 mb-2 rounded-2 mx-2" style="background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.2);">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="small fw-bold text-info"><i class="ti ti-shield me-1"></i> Admin Active</span>
                  <%= link_to "Admin Panel", admin_dashboard_path, class: "badge bg-primary text-white text-decoration-none" %>
                </div>
              </div>
            <% end %>

            <%= link_to customer_profile_path, class: "bc-pdrop-item #{'active' if active == 'profile'}", role: "menuitem" do %>
              <i class="ti ti-user-circle"></i>
              <div class="bc-pdrop-item-text">
                <span class="title">My Profile</span>
                <span class="sub">Personal details & addresses</span>
              </div>
            <% end %>

            <%= link_to customer_bookings_path, class: "bc-pdrop-item #{'active' if active == 'bookings'}", role: "menuitem" do %>
              <i class="ti ti-calendar-event"></i>
              <div class="bc-pdrop-item-text">
                <span class="title">My Bookings</span>
                <span class="sub">Track & manage home services</span>
              </div>
              <% if (active_count = current_customer.customer_bookings.where.not(booking_status: %w[completed cancelled rejected]).count) > 0 %>
                <span class="bc-pdrop-pill"><%= active_count %></span>
              <% end %>
            <% end %>

            <%= link_to customer_profile_path(tab: "addresses"), class: "bc-pdrop-item", role: "menuitem" do %>
              <i class="ti ti-map-pin"></i>
              <div class="bc-pdrop-item-text">
                <span class="title">Saved Addresses</span>
                <span class="sub">Manage delivery locations</span>
              </div>
            <% end %>

            <%= link_to cart_path, class: "bc-pdrop-item", role: "menuitem" do %>
              <i class="ti ti-shopping-bag"></i>
              <div class="bc-pdrop-item-text">
                <span class="title">My Cart</span>
                <span class="sub">Review services & checkout</span>
              </div>
              <% if current_cart.item_count > 0 %>
                <span class="bc-pdrop-pill"><%= current_cart.item_count %></span>
              <% end %>
            <% end %>
          </div>

          <div class="bc-pdrop-footer">
            <%= link_to logout_path(role: "customer"), class: "bc-pdrop-logout", data: { turbo: false }, role: "menuitem" do %>
              <i class="ti ti-logout"></i> Sign Out (Customer)
            <% end %>
          </div>
        </div>
      </div>

    <% elsif admin_logged_in? %>
      <!-- Admin session active viewing storefront -->
      <div class="bc-nav-profile-wrap me-1" id="bc-nav-profile-wrap">
        <button type="button" class="bc-profile-btn" id="bc-profile-dropdown-btn" aria-expanded="false" aria-haspopup="true" style="border-color: rgba(219,39,119,0.35); background: rgba(219,39,119,0.06);">
          <span class="bc-profile-avatar-wrap">
            <span class="bc-profile-avatar-fallback" style="background: linear-gradient(135deg, #db2777, #be185d);"><%= current_admin.initials %></span>
          </span>
          <span class="bc-profile-name d-none d-sm-inline fw-bold" style="color: #db2777;">Admin Active</span>
          <i class="ti ti-chevron-down bc-profile-chevron"></i>
        </button>
        <div class="bc-profile-dropdown" id="bc-profile-dropdown-menu" role="menu">
          <div class="bc-pdrop-header">
            <div class="bc-pdrop-name"><%= current_admin.name %></div>
            <div class="bc-pdrop-meta"><%= current_admin.email %></div>
            <span class="bc-pdrop-badge"><i class="ti ti-shield"></i> Administrator Session</span>
          </div>
          <div class="bc-pdrop-items">
            <%= link_to admin_dashboard_path, class: "bc-pdrop-item", role: "menuitem" do %>
              <i class="ti ti-layout-dashboard text-primary"></i>
              <div class="bc-pdrop-item-text">
                <span class="title text-primary">Go to Admin Panel</span>
                <span class="sub">Manage platform, workers & bookings</span>
              </div>
            <% end %>
            <%= link_to switch_customer_demo_path, class: "bc-pdrop-item", role: "menuitem" do %>
              <i class="ti ti-user-check text-success"></i>
              <div class="bc-pdrop-item-text">
                <span class="title text-success">1-Click Test as Customer</span>
                <span class="sub">Operate storefront with sample user</span>
              </div>
            <% end %>
          </div>
          <div class="bc-pdrop-footer">
            <%= link_to logout_path(role: "admin"), class: "bc-pdrop-logout", data: { turbo: false }, role: "menuitem" do %>
              <i class="ti ti-logout"></i> Sign Out of Admin
            <% end %>
          </div>
        </div>
      </div>

      <%= link_to login_path(role: "customer"), class: "bc-btn-ghost me-1", title: "Sign in with a customer account" do %>Sign In<% end %>
      <%= link_to signup_path, class: "bc-btn-pink" do %>
        <i class="ti ti-user-plus"></i> Sign Up
      <% end %>

    <% elsif worker_logged_in? %>
      <div class="bc-nav-profile-wrap" id="bc-nav-profile-wrap">
        <button type="button" class="bc-profile-btn" id="bc-profile-dropdown-btn" aria-expanded="false" aria-haspopup="true">
          <span class="bc-profile-avatar-wrap">
            <span class="bc-profile-avatar-fallback"><%= current_user.initials %></span>
          </span>
          <span class="bc-profile-name d-none d-sm-inline"><%= current_user.name.split.first %></span>
          <i class="ti ti-chevron-down bc-profile-chevron"></i>
        </button>
        <div class="bc-profile-dropdown" id="bc-profile-dropdown-menu" role="menu">
          <div class="bc-pdrop-header">
            <div class="bc-pdrop-name"><%= current_user.name %></div>
            <div class="bc-pdrop-meta"><%= current_user.phone.presence || current_user.email %></div>
            <span class="bc-pdrop-badge"><i class="ti ti-cut"></i> Service Specialist</span>
          </div>
          <div class="bc-pdrop-items">
            <%= link_to admin_dashboard_path, class: "bc-pdrop-item", role: "menuitem" do %>
              <i class="ti ti-cut"></i>
              <div class="bc-pdrop-item-text">
                <span class="title">Worker Portal</span>
                <span class="sub">Assigned jobs & schedule</span>
              </div>
            <% end %>
          </div>
          <div class="bc-pdrop-footer">
            <%= link_to logout_path, class: "bc-pdrop-logout", data: { turbo: false }, role: "menuitem" do %>
              <i class="ti ti-logout"></i> Sign Out
            <% end %>
          </div>
        </div>
      </div>

    <% else %>
      <%= link_to login_path(role: "customer"), class: "bc-btn-ghost" do %><%= t("nav.sign_in") %><% end %>
      <%= link_to signup_path, class: "bc-btn-pink" do %>
        <i class="ti ti-user-plus"></i> <%= t("nav.sign_up") %>
      <% end %>
    <% end %>
  </div>

  <button class="bc-hamburger" id="bc-hamburger" aria-label="Toggle menu">
    <i class="ti ti-menu-2"></i>
  </button>
</nav>
</header>

<!-- Mobile Drawer -->
<div class="bc-mobile-drawer" id="bc-mobile-drawer">
  <div class="bc-mobile-drawer-inner">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(0,0,0,0.08);">
      <span style="font-weight: 700; font-size: 0.88rem; color: #111827;">Language / भाषा:</span>
      <div class="bc-lang-toggle" role="group" aria-label="Language Selector">
        <%= link_to switch_locale_path(locale: "en"), class: "bc-lang-opt #{'active' if english?}", title: "English" do %>
          EN
        <% end %>
        <span class="bc-lang-divider">/</span>
        <%= link_to switch_locale_path(locale: "hi"), class: "bc-lang-opt #{'active' if hindi?}", title: "हिन्दी" do %>
          हिन्दी
        <% end %>
      </div>
    </div>

    <a href="/"            class="bc-mobile-link"><%= t("nav.home") %></a>
    <a href="/categories"  class="bc-mobile-link"><%= t("nav.services") %></a>
    <a href="/offers"      class="bc-mobile-link"><%= t("nav.offers") %> <span class="bc-hot-badge"><%= t("nav.hot_badge") %></span></a>
    <a href="/cart"        class="bc-mobile-link"><%= t("nav.cart") %> (<span id="bn-mobile-cart-badge"><%= current_cart.item_count %></span>)</a>
    <a href="/about"       class="bc-mobile-link"><%= t("nav.about") %></a>
    <a href="/contact"     class="bc-mobile-link"><%= t("nav.contact") %></a>
    <a href="/privacy"     class="bc-mobile-link"><%= t("footer.privacy") %></a>

    <div class="bc-mobile-auth">
      <% if customer_logged_in? %>
        <div class="bc-mobile-user-card">
          <div class="bc-mobile-user-avatar"><%= current_customer.initials %></div>
          <div>
            <div class="fw-bold text-dark"><%= current_customer.name %></div>
            <div class="small text-muted"><%= current_customer.phone.presence || current_customer.email %></div>
          </div>
        </div>
        <% if admin_logged_in? %>
          <div class="p-2 mb-2 rounded bg-light border text-center">
            <span class="small fw-bold text-info"><i class="ti ti-shield me-1"></i> Admin Session Active</span><br>
            <%= link_to "Go to Admin Panel", admin_dashboard_path, class: "btn btn-sm btn-outline-primary mt-1 w-100" %>
          </div>
        <% end %>
        <%= link_to customer_profile_path, class: "bc-mobile-link" do %>
          <i class="ti ti-user-circle me-2"></i> My Profile
        <% end %>
        <%= link_to customer_bookings_path, class: "bc-mobile-link" do %>
          <i class="ti ti-calendar-event me-2"></i> My Bookings
          <% if (active_count = current_customer.customer_bookings.where.not(booking_status: %w[completed cancelled rejected]).count) > 0 %>
            <span class="bc-mobile-counter-pill"><%= active_count %></span>
          <% end %>
        <% end %>
        <%= link_to customer_profile_path(tab: "addresses"), class: "bc-mobile-link" do %>
          <i class="ti ti-map-pin me-2"></i> Saved Addresses
        <% end %>
        <%= link_to "/categories", class: "bc-btn-pink bc-w-full my-2" do %>
          <i class="ti ti-sparkles me-1"></i> Book Services
        <% end %>
        <%= link_to logout_path(role: "customer"), class: "bc-btn-ghost bc-w-full", data: { turbo: false } do %>
          <i class="ti ti-logout me-1"></i> Sign Out (Customer)
        <% end %>

      <% elsif admin_logged_in? %>
        <div class="bc-mobile-user-card">
          <div class="bc-mobile-user-avatar" style="background: linear-gradient(135deg, #db2777, #be185d);"><%= current_admin.initials %></div>
          <div>
            <div class="fw-bold text-dark"><%= current_admin.name %></div>
            <div class="small text-muted">Administrator Session</div>
          </div>
        </div>
        <%= link_to "Return to Admin Panel", admin_dashboard_path, class: "bc-btn-pink bc-w-full mb-2" %>
        <%= link_to switch_customer_demo_path, class: "btn btn-outline-success bc-w-full mb-2" do %>
          <i class="ti ti-user-check me-1"></i> 1-Click Test as Customer
        <% end %>
        <%= link_to "Sign In as Customer", login_path(role: "customer"), class: "bc-btn-ghost bc-w-full mb-2" %>
        <%= link_to "Sign Out of Admin", logout_path(role: "admin"), class: "bc-btn-ghost bc-w-full text-danger", data: { turbo: false } %>

      <% elsif worker_logged_in? %>
        <div class="bc-mobile-user-card">
          <div class="bc-mobile-user-avatar"><%= current_user.initials %></div>
          <div>
            <div class="fw-bold text-dark"><%= current_user.name %></div>
            <div class="small text-muted">Service Specialist</div>
          </div>
        </div>
        <%= link_to "Worker Portal", admin_dashboard_path, class: "bc-btn-pink bc-w-full" %>
        <%= link_to "Sign Out", logout_path, class: "bc-btn-ghost bc-w-full", data: { turbo: false } %>

      <% else %>
        <%= link_to "Sign In", login_path(role: "customer"), class: "bc-btn-ghost bc-w-full" %>
        <%= link_to "Sign Up", signup_path, class: "bc-btn-pink bc-w-full" %>
      <% end %>
    </div>
  </div>
</div>
<div class="bc-drawer-overlay" id="bc-drawer-overlay"></div>

<script>
  (function() {
    var hamburger = document.getElementById('bc-hamburger');
    var drawer = document.getElementById('bc-mobile-drawer');
    var overlay = document.getElementById('bc-drawer-overlay');
    function toggleDrawer() {
      drawer.classList.toggle('bc-drawer-open');
      overlay.classList.toggle('bc-overlay-visible');
    }
    hamburger && hamburger.addEventListener('click', toggleDrawer);
    overlay && overlay.addEventListener('click', toggleDrawer);

    // Profile Dropdown functionality
    var profileWrap = document.getElementById('bc-nav-profile-wrap');
    var profileBtn = document.getElementById('bc-profile-dropdown-btn');
    var profileMenu = document.getElementById('bc-profile-dropdown-menu');

    if (profileBtn && profileMenu) {
      function toggleProfileMenu(e) {
        e.stopPropagation();
        var isOpen = profileMenu.classList.contains('show');
        if (isOpen) {
          closeProfileMenu();
        } else {
          openProfileMenu();
        }
      }

      function openProfileMenu() {
        profileMenu.classList.add('show');
        profileBtn.setAttribute('aria-expanded', 'true');
      }

      function closeProfileMenu() {
        profileMenu.classList.remove('show');
        profileBtn.setAttribute('aria-expanded', 'false');
      }

      profileBtn.addEventListener('click', toggleProfileMenu);

      // Close on outside click
      document.addEventListener('click', function(e) {
        if (!profileWrap.contains(e.target)) {
          closeProfileMenu();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && profileMenu.classList.contains('show')) {
          closeProfileMenu();
        }
      });
    }

    // Navbar scroll shadow
    window.addEventListener('scroll', function() {
      var nav = document.querySelector('.bc-nav');
      if (nav) nav.classList.toggle('scrolled', window.scrollY > 20);
    });
  })();
</script>
