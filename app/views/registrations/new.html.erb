<div class="card-body p-4 p-md-5">
  <div class="text-center mb-4">
    <div class="avatar avatar-lg rounded-circle mx-auto mb-3"
         style="background: linear-gradient(135deg, rgba(219, 39, 119, 0.15), rgba(190, 24, 93, 0.1)); border: 1px solid rgba(219, 39, 119, 0.3);">
      <i class="ti ti-user-plus fs-1" style="color: #db2777;"></i>
    </div>
    <h2 class="h2 text-center mb-1 fw-bold">Create an Account</h2>
    <p class="text-secondary small">Join <%= site_name %> today</p>
  </div>

  <% if @user.errors.any? %>
    <div class="alert alert-danger alert-dismissible v6-alert-box mb-4" role="alert">
      <div class="d-flex">
        <div><i class="ti ti-alert-circle fs-2 me-2"></i></div>
        <div>
          <ul class="mb-0 ps-2">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
      <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
    </div>
  <% end %>

  <%= form_with model: @user, url: signup_path, method: :post do |f| %>
    <div class="mb-3">
      <%= f.label :name, "Full Name", class: "form-label mb-1 required" %>
      <div class="auth-input-wrap">
        <span class="auth-icon-left">
          <i class="ti ti-user"></i>
        </span>
        <%= f.text_field :name, class: "form-control no-right-icon", placeholder: "e.g. Priya Sharma", required: true, autofocus: true %>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <%= f.label :email, "Email Address", class: "form-label mb-1 required" %>
        <div class="auth-input-wrap">
          <span class="auth-icon-left">
            <i class="ti ti-mail"></i>
          </span>
          <%= f.email_field :email, class: "form-control no-right-icon", placeholder: "priya@example.com", required: true %>
        </div>
      </div>
      <div class="col-md-6">
        <%= f.label :phone, "Mobile Number", class: "form-label mb-1 required" %>
        <div class="auth-input-wrap">
          <span class="auth-icon-left">
            <i class="ti ti-phone"></i>
          </span>
          <%= f.telephone_field :phone, class: "form-control no-right-icon", placeholder: "+91 98765 43210", required: true %>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <%= f.label :password, "Password", class: "form-label mb-1 required" %>
        <div class="auth-input-wrap">
          <span class="auth-icon-left">
            <i class="ti ti-lock"></i>
          </span>
          <%= f.password_field :password, id: "signup-password", class: "form-control",
                               placeholder: "Min. 6 chars", required: true, minlength: 6 %>
          <button type="button" class="auth-icon-right-btn" title="Toggle password" onclick="togglePassword(event, this, 'signup-password')">
            <i class="ti ti-eye fs-3"></i>
          </button>
        </div>
      </div>
      <div class="col-md-6">
        <%= f.label :password_confirmation, "Confirm Password", class: "form-label mb-1 required" %>
        <div class="auth-input-wrap">
          <span class="auth-icon-left">
            <i class="ti ti-lock-check"></i>
          </span>
          <%= f.password_field :password_confirmation, id: "signup-password-confirmation", class: "form-control",
                               placeholder: "Re-enter password", required: true, minlength: 6 %>
          <button type="button" class="auth-icon-right-btn" title="Toggle password" onclick="togglePassword(event, this, 'signup-password-confirmation')">
            <i class="ti ti-eye fs-3"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="form-footer mb-3">
      <button type="submit" class="auth-btn-submit">
        <i class="ti ti-user-plus fs-2"></i> Sign Up
      </button>
    </div>
  <% end %>

  <div class="text-center text-secondary small mt-4 pt-3 border-top auth-card-footer">
    Already have an account? <%= link_to "Sign In", login_path, class: "link-primary fw-medium" %>
  </div>
</div>

<script>
  function togglePassword(e, el, inputId) {
    e.preventDefault();
    const input = document.getElementById(inputId);
    const icon = el.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'ti ti-eye-off fs-3';
    } else {
      input.type = 'password';
      icon.className = 'ti ti-eye fs-3';
    }
  }
</script>
